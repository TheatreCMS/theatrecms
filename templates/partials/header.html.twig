<header class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-semibold text-gray-900">{{ name }}</a>
        {% if get_menu('primary') is not null %}
            {{ render_menu('primary') }}
        {% else %}
            {# No menu assigned to the "primary" location yet — falls back to these
               links until an admin creates one at /admin/menus. #}
            <nav class="space-x-4 text-sm text-gray-600">
                <a href="/" class="hover:text-gray-900">Home</a>
                <a href="/productions" class="hover:text-gray-900">Productions</a>
                <a href="/events" class="hover:text-gray-900">Events</a>
                <a href="/people" class="hover:text-gray-900">People</a>
            </nav>
        {% endif %}
    </div>
</header>