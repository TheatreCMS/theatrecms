{% extends 'layouts/frontend.html.twig' %}

{% block title %}Seasons - {{ parent() }}{% endblock %}

{% block content %}
    <h1>Our Seasons</h1>
    <ul>
        {% for season in seasons %}
            <li><a href="seasons/{{ season.slug }}">{{ season.label }}</a></li>
        {% else %}
            <li>No seasons found.</li>
        {% endfor %}
    </ul>
{% endblock %}