{% extends 'layouts/base.html.twig' %}

{% block title %}{{ production.name }} - {{ parent() }}{% endblock %}

{% block content %}
    <article class="max-w-4xl mx-auto space-y-6">
        <header class="space-y-2 border-b border-gray-200 pb-4">
            <p class="text-xs uppercase tracking-wide text-gray-500">
                {{ production.season.label }}
            </p>
            <h1 class="text-4xl font-semibold text-gray-900">{{ production.name }}</h1>
            {% set dateRange = null %}
            {% if production.opening and production.closing %}
                {% set dateRange = production.opening|date('F j, Y') ~ ' – ' ~ production.closing|date('F j, Y') %}
            {% elseif production.opening %}
                {% set dateRange = 'Opens ' ~ production.opening|date('F j, Y') %}
            {% elseif production.closing %}
                {% set dateRange = 'Closes ' ~ production.closing|date('F j, Y') %}
            {% endif %}
            {% if dateRange %}
                <p class="text-lg text-gray-600">{{ dateRange }}</p>
            {% endif %}
            {% if production.venue %}
                <p class="text-sm text-gray-500">{{ production.venue.name }}</p>
            {% endif %}
        </header>

        <section class="space-y-6 leading-relaxed text-gray-700">
            {% if production.description %}
                {{ production.description|block_content_to_html }}
            {% else %}
                <p class="italic text-gray-500">Description coming soon.</p>
            {% endif %}
        </section>
    </article>
{% endblock %}
