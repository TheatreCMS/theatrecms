<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <title>
            {% block title %}Admin -
                {{ organization_name|default('TheatreCMS') }}
            {% endblock %}
        </title>

        {# Tailwind via CDN for now; swap with asset pipeline later #}
        <link
        href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">

        {# Flowbite for components #}
        <link href="https://cdn.jsdelivr.net/npm/flowbite@2/dist/flowbite.min.css" rel="stylesheet"/>
        <script src="https://cdn.jsdelivr.net/npm/flowbite@2/dist/flowbite.min.js"></script>

        {# Active theme's color palette (theme.json settings.color.palette), for EditorJS blocks that offer color choices #}
        <script>window.THEATRECMS_COLOR_PALETTE = {{ theme_color_palette|json_encode(constant('JSON_HEX_TAG'))|raw }};</script>

        {# EditorJS for block editing (local copies) #}
        <script src="/assets/js/editorjs/editor.js"></script>
        <script src="/assets/js/editorjs/header.js"></script>
        <script src="/assets/js/editorjs/list.js"></script>
        <script src="/assets/js/editorjs/underline.js"></script>
        <script src="/assets/js/editorjs/cite.js"></script>
        <script src="/assets/js/editorjs/quote.js"></script>
        <script src="/assets/js/editorjs/quote-color-scheme.js"></script>
        <script src="/assets/js/editorjs/image.js"></script>
        <script src="/assets/js/editorjs/link.js"></script>
        <script src="/assets/js/editorjs/columns.js"></script>
        <script src="/assets/js/editorjs/table.js"></script>
        <script src="/assets/js/editorjs/callout.js"></script>
        <script src="/assets/js/editorjs/sponsor-block.js"></script>
        <script src="/assets/js/editorjs/sponsor.js"></script>
        <script src="/assets/js/editorjs/cta-card.js"></script>
        <script src="/assets/js/editorjs/schedule.js"></script>
        <script src="/assets/js/editorjs/gallery.js"></script>
        <script src="/assets/js/editorjs/carousel.js"></script>
        <script src="/assets/js/editorjs/text-variant-tune.js"></script>
        <link rel="stylesheet" href="/assets/css/editorjs-editor.css">

        {# HTMX for progressive enhancement #}
        <script src="https://unpkg.com/htmx.org@1.9.2"></script>

        <link rel="stylesheet" href="/assets/js/ckeditor5/ckeditor5.css">
        <script type="importmap">
            {
                        "imports": {
                            "ckeditor5": "/assets/js/ckeditor5/ckeditor5.js",
                            "ckeditor5/": "/assets/js/ckeditor5/"
                        }
                    }
        </script>
        <style>
            .admin-nav-group > summary { list-style: none; }
            .admin-nav-group > summary::-webkit-details-marker { display: none; }
            .admin-nav-chevron { transition: transform 150ms ease; }
            .admin-nav-group[open] .admin-nav-chevron { transform: rotate(90deg); }
        </style>
        {% block head %}{% endblock %}
    </head>
    <body class="bg-gray-100 min-h-screen text-gray-900">

        <div
            class="min-h-screen flex">
            <!-- Sidebar -->
            <aside class="w-64 bg-white border-r hidden md:block">
                <div class="p-4 border-b">
                    <a href="/{{ base_path|default('') }}" class="flex items-center space-x-3" title="View the site">
                        <img src="{{ logo_url|default('/assets/images/logo.svg') }}" alt="{{ organization_name|default('TheatreCMS') }}" class="h-8 w-8">
                        <span class="font-semibold">{{ organization_name|default('TheatreCMS') }}</span>
                    </a>
                </div>
                <nav class="p-4">
                    {# Sidebar nav: Dashboard on its own, then content types, then site administration.
                       A group's heading is only shown when the user can access at least one of its items. #}
                    {% set nav_groups = [
                {label: null, items: [
                    {label: 'Dashboard', url: base_path ~ 'admin', capability: null, exact: true},
                ]},
                {label: 'Content', items: [
                    {label: 'Seasons', url: base_path ~ 'admin/seasons', capability: 'manage_productions'},
                    {label: 'Productions', url: base_path ~ 'admin/productions', capability: 'manage_productions'},
                    {label: 'Events', url: base_path ~ 'admin/events', capability: 'manage_productions'},
                    {label: 'Works', url: base_path ~ 'admin/works', capability: 'manage_people'},
                    {label: 'People', url: base_path ~ 'admin/people', capability: 'manage_people'},
                    {label: 'Venues', url: base_path ~ 'admin/venues', capability: 'manage_productions'},
                    {label: 'Sponsors', url: base_path ~ 'admin/sponsors', capability: 'manage_productions'},
                    {label: 'Posts', url: base_path ~ 'admin/posts', capability: 'edit_posts'},
                    {label: 'Pages', url: base_path ~ 'admin/pages', capability: 'edit_pages'},
                    {label: 'Media', url: base_path ~ 'admin/media', capability: 'upload_files'},
                ]},
                {label: 'Appearance', items: [
                  {label: 'Menus', url: base_path ~ 'admin/menus', capability: 'manage_menus'},
                ]},
                {label: 'Administration', items: [
                    {label: 'Users', url: base_path ~ 'admin/users', capability: 'manage_users'},
                    {label: 'Settings', url: base_path ~ 'admin/settings', capability: 'manage_options'},
                ]},
            ] %}

                    {% for group in nav_groups %}
                        {% set visible_items = group.items|filter(item => item.capability is null or can(item.capability)) %}
                        {% if visible_items is not empty %}
                            {# Active when the request path (set by RequireTwigMiddleware) is the item's URL or below it;
                               `exact` items (Dashboard, whose URL prefixes every admin page) match only themselves. #}
                            {% set request_path = (current_path ?? '')|trim('/', 'right') %}
                            {% set active_urls = visible_items|filter(item => request_path == '/' ~ item.url|trim('/')
                                or (not (item.exact ?? false) and request_path starts with '/' ~ item.url|trim('/') ~ '/'),
                            )|column('url') %}
                            {% set item_links %}
                                {% for item in visible_items %}
                                    {% set is_active = item.url in active_urls %}
                                    <a href="/{{ item.url|trim('/') }}" class="block rounded-md px-3 py-2 mb-1 text-sm font-medium {% if is_active %}bg-blue-50 text-blue-600{% else %}text-gray-700 hover:bg-gray-50{% endif %}">
                                        {{ item.label }}
                                    </a>
                                {% endfor %}
                            {% endset %}

                            {% if group.label %}
                                {# Collapsible section; open by default, collapse state remembered per browser (see script below) #}
                                <details class="admin-nav-group mt-4 pt-4 border-t" data-nav-group="{{ group.label|lower }}" {% if active_urls is not empty %}data-has-active{% endif %} open>
                                    <summary class="flex items-center justify-between px-3 mb-2 cursor-pointer select-none text-xs font-semibold uppercase tracking-wider text-gray-400 hover:text-gray-600">
                                        {{ group.label }}
                                        <svg class="admin-nav-chevron h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.17 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/>
                                        </svg>
                                    </summary>
                                    {{ item_links }}
                                </details>
                            {% else %}
                                <div>{{ item_links }}</div>
                            {% endif %}
                        {% endif %}
                    {% endfor %}

                    {# Runs inline (not on DOMContentLoaded) so collapsed sections don't flash open on load.
                       A section containing the current page is always shown open. #}
                    <script>
                        (function () {
                            var key = function (el) { return 'admin-nav-collapsed:' + el.dataset.navGroup; };
                            document.querySelectorAll('details[data-nav-group]').forEach(function (el) {
                                try {
                                    if (localStorage.getItem(key(el)) === '1' && !el.hasAttribute('data-has-active')) {
                                        el.open = false;
                                    }
                                } catch (e) {}
                                el.addEventListener('toggle', function () {
                                    try { localStorage.setItem(key(el), el.open ? '0' : '1'); } catch (e) {}
                                });
                            });
                        })();
                    </script>
                </nav>
            </aside>

            <!-- Main content area -->
            <div
                class="flex-1">
                <!-- Top navigation (mobile + desktop) -->
                <header class="bg-white border-b">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="flex justify-between h-16 items-center">
                            <div class="flex items-center">
                                <button id="sidebarToggle" class="md:hidden mr-3 px-2 py-1 rounded bg-gray-100">
                                    Menu
                                </button>
                            </div>
                            <div class="flex items-center space-x-4">
                                <div class="text-sm text-gray-600">Signed in as
                                    <strong>{{ current_user.name|default('Admin') }}</strong>
                                </div>
                                <a href="/{{ base_path|default('') }}admin/profile" class="text-sm text-gray-600 hover:text-gray-900">My Profile</a>
                                <a href="/{{ base_path|default('') }}admin/logout" class="text-sm text-red-600">Logout</a>
                            </div>
                        </div>
                    </div>
                </header>

                <main
                    class="p-6 max-w-7xl mx-auto">
                    {# Flash messages #}
                    <div id="flash-messages">
                        {% for type, messages in flash|default({}) %}
                            {% for message in messages %}
                                {% set bg = 'bg-green-50 text-green-800 border-green-200' %}
                                {% if type == 'error' or type == 'danger' %}
                                    {% set bg = 'bg-red-50 text-red-800 border-red-200' %}
                                {% elseif type == 'warning' %}
                                    {% set bg = 'bg-yellow-50 text-yellow-800 border-yellow-200' %}
                                {% endif %}
                                <div class="mb-4 border-l-4 p-3 {{ bg }} rounded">
                                    {{ message }}
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>

                    {# Page content block #}
                    <div class="bg-white shadow-sm rounded p-6"> {% block content %}{% endblock %}
                        </div>
                    </main>

                    {% block footer %}
                        <footer class="text-center p-4 text-sm text-gray-500">
                            &copy;
                            {{ 'now'|date('Y') }}
                            TheatreCMS. All rights reserved.
                        </footer>
                    {% endblock %}
                </div>
            </div>

            {# Small script to toggle sidebar on mobile #}
            <script>
                document.addEventListener('DOMContentLoaded', function () {
var toggle = document.getElementById('sidebarToggle');
if (! toggle)
return;

toggle.addEventListener('click', function () {
var aside = document.querySelector('aside');
if (! aside)
return;

aside.classList.toggle('hidden');
});
});
            </script>
            <script src="/assets/js/searchable-select.js"></script>

            {% block scripts %}{% endblock %}

        </body>
    </html>
