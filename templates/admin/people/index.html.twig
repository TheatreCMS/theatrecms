{% extends 'layouts/admin.html.twig' %}

{% block title %}People - {{ parent() }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">People</h1>
        <p class="text-gray-600">Actors, conductors, musicians, choreographers, playwrights...</p>
    </div>
    <div>
        <a href="/admin/people/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Add New Person</a>
    </div>
</div>

<div class="mb-4">
    <input
        type="search"
        name="q"
        value="{{ pagination.search }}"
        placeholder="Search by name..."
        class="w-full max-w-sm rounded border border-default px-3 py-2 text-sm"
        hx-get="/admin/people"
        hx-trigger="input changed delay:300ms, search"
        hx-target="#peopleListContainer"
        hx-swap="outerHTML"
        hx-push-url="true">
</div>

{% include 'admin/people/_list.html.twig' with {'people': people, 'pagination': pagination} %}
{% endblock %}
