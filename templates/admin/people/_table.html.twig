{% for p in people %}
    <tr class="bg-neutral-primary border-b border-default">
        <td class="px-6 py-4">
            {% if p.headshotUrl %}
                <img
                    src="{{ p.headshotUrl }}"
                    alt="Headshot of {{ p.name }}"
                    class="h-10 w-10 rounded-full object-cover border border-gray-200 bg-gray-50"
                >
            {% else %}
                <div class="h-10 w-10 rounded-full border border-dashed border-gray-300 bg-gray-50 flex items-center justify-center text-[10px] text-gray-400 uppercase">
                    No photo
                </div>
            {% endif %}
        </td>
        <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">{{ p.lastName }}</th>
        <td class="px-6 py-4">{{ p.firstName }}</td>
        <td class="px-6 py-4">
            <a href="/admin/people/edit/{{ p.id }}" class="text-blue-600 hover:text-blue-900 mr-4">Edit</a>
            <button
                type="button"
                class="text-red-600 hover:text-red-900"
                hx-delete="/admin/people/{{ p.id }}?page={{ pagination.page }}"
                hx-target="#peopleListContainer"
                hx-swap="outerHTML"
                hx-confirm="Delete this person? This cannot be undone.">
                Delete
            </button>
        </td>
    </tr>
{% else %}
    <tr class="bg-neutral-primary border-b border-default">
        <td class="px-6 py-4" colspan="4">No people found.</td>
    </tr>
{% endfor %}
