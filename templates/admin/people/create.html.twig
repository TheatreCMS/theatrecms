{% extends 'layouts/admin.html.twig' %}

{% block title %}Create Person - {{ parent() }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Add New Person</h1>
        <p class="text-gray-600">Enter information for the new person.</p>
    </div>

    <form action="/admin/people/create" method="POST" class="space-y-6"
          hx-post="/admin/people/create" hx-target="#flash-messages" hx-swap="innerHTML">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First Name <span class="text-red-500">*</span></label>
                <input type="text" name="firstName" id="firstName" required class="w-full rounded-md border-gray-300 shadow-sm" placeholder="e.g. Jane">
            </div>

            <div>
                <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name <span class="text-red-500">*</span></label>
                <input type="text" name="lastName" id="lastName" required class="w-full rounded-md border-gray-300 shadow-sm" placeholder="e.g. Doe">
            </div>

            <div class="md:col-span-2">
                <label for="biography-editor" class="block text-sm font-medium text-gray-700 mb-1">Biography</label>
                <div id="biography-editor" class="rounded-md border border-gray-200 bg-white shadow-sm"></div>
                <textarea name="biography" id="biography" rows="6" class="hidden" aria-hidden="true"></textarea>
            </div>

            <div class="md:col-span-2">
                <label for="headshotUrl" class="block text-sm font-medium text-gray-700 mb-1">Headshot URL</label>
                <input type="url" name="headshotUrl" id="headshotUrl" class="w-full rounded-md border-gray-300 shadow-sm" placeholder="https://example.com/photo.jpg">
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t">
            <a href="/admin/people" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancel</a>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">Add New Person</button>
        </div>
    </form>

    <script type="module">
        import { initRichTextEditor } from '/assets/js/richtext-editor.js';
        initRichTextEditor('biography-editor', 'biography');
    </script>
{% endblock %}
