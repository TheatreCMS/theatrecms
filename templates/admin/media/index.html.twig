{% extends 'layouts/admin.html.twig' %}

{% block title %}Media Library - {{ parent() }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">Media Library</h1>
        <p class="text-gray-600">Every image, PDF, audio, and video file uploaded to the media library.</p>
    </div>
</div>

<form
    hx-post="/admin/media/library-upload"
    hx-target="#media-upload-result"
    hx-swap="innerHTML"
    hx-encoding="multipart/form-data"
    class="flex items-center gap-3 mb-4 p-3 rounded-md border border-dashed border-gray-300 bg-gray-50"
>
    <label for="media-library-upload" class="text-sm font-medium text-gray-700">Upload new:</label>
    <input type="file" name="file" id="media-library-upload" required class="text-sm">
    <button type="submit" class="px-3 py-1.5 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700">Upload</button>
</form>

<div id="media-upload-result"></div>

<form class="mb-4 flex flex-wrap items-center gap-3" hx-get="/admin/media" hx-target="#media-grid" hx-swap="outerHTML">
    <input
        type="search"
        placeholder="Search files by filename…"
        value="{{ pagination.search|default('') }}"
        hx-get="/admin/media"
        hx-trigger="keyup changed delay:300ms"
        hx-target="#media-grid"
        hx-swap="outerHTML"
        hx-include="[name=type]"
        name="q"
        class="w-full max-w-sm rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
    >
    <select
        name="type"
        hx-get="/admin/media"
        hx-trigger="change"
        hx-target="#media-grid"
        hx-swap="outerHTML"
        hx-include="[name=q]"
        class="rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
    >
        <option value="" {% if not type %}selected{% endif %}>All types</option>
        <option value="image" {% if type == 'image' %}selected{% endif %}>Images</option>
        <option value="pdf" {% if type == 'pdf' %}selected{% endif %}>PDFs</option>
        <option value="audio" {% if type == 'audio' %}selected{% endif %}>Audio</option>
        <option value="video" {% if type == 'video' %}selected{% endif %}>Video</option>
    </select>
</form>

<div class="bg-white border border-gray-200 rounded-md shadow-sm">
    {% include 'admin/media/_grid.html.twig' with {'media': media, 'pagination': pagination} %}
</div>

{% include 'admin/media/_details_modal.html.twig' %}

<script type="module">
    import { initMediaDetailsModal } from '/assets/js/media-details-modal.js';
    initMediaDetailsModal();
</script>
{% endblock %}
