{% extends 'layouts/admin.html.twig' %}

{% set productions = productions|default([]) %}
{% set venues = venues|default([]) %}

{% block title %}Create Event - {{ parent() }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Create New Event</h1>
        <p class="text-gray-600">Enter the details for the new event.</p>
    </div>

    <form action="/admin/events/create" method="POST" class="space-y-6"
          hx-post="/admin/events/create" hx-target="#flash-messages" hx-swap="innerHTML">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title <em>(leave blank to use production name)</em></label>
                <input type="text" name="title" id="title" maxlength="255"
                       class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div>
                <label for="productionId" class="block text-sm font-medium text-gray-700 mb-1">Production</label>
                <select name="productionId" id="productionId" class="searchable-select w-full rounded-md border-gray-300 shadow-sm">
                    <option value="">None</option>
                    {% for p in productions %}
                        <option value="{{ p.id }}">{{ p.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="venueId" class="block text-sm font-medium text-gray-700 mb-1">Venue</label>
                <select name="venueId" id="venueId" class="searchable-select w-full rounded-md border-gray-300 shadow-sm">
                    <option value="">None</option>
                    {% for v in venues %}
                        <option value="{{ v.id }}">{{ v.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="startsAt" class="block text-sm font-medium text-gray-700 mb-1">Starts At <span class="text-red-500">*</span></label>
                <input type="datetime-local" name="startsAt" id="startsAt" required
                       class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div>
                <label for="endsAt" class="block text-sm font-medium text-gray-700 mb-1">Ends At</label>
                <input type="datetime-local" name="endsAt" id="endsAt"
                       class="w-full rounded-md border-gray-300 shadow-sm">
                <p class="mt-1 text-xs text-gray-500">Optional.</p>
            </div>

            <div>
                <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                <select name="status" id="status" class="searchable-select w-full rounded-md border-gray-300 shadow-sm">
                    <option value="scheduled">Scheduled</option>
                    <option value="cancelled">Cancelled</option>
                    <option value="postponed">Postponed</option>
                </select>
            </div>

            <div class="md:col-span-2">
                <label for="ticketUrl" class="block text-sm font-medium text-gray-700 mb-1">Ticket URL</label>
                <input type="url" name="ticketUrl" id="ticketUrl" placeholder="https://example.com/tickets"
                       class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div class="md:col-span-2">
                <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                <textarea name="notes" id="notes" rows="4" class="w-full rounded-md border-gray-300 shadow-sm"></textarea>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t">
            <a href="/admin/events" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancel</a>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">Create Event</button>
        </div>
    </form>

{% endblock %}
