{% extends 'layouts/admin.html.twig' %}

{% set productions = productions|default([]) %}
{% set venues = venues|default([]) %}

{% block title %}Edit Event - {{ parent() }}{% endblock %}

{% block content %}
    {% include 'admin/partials/_edit_header.html.twig' with {
        formId: 'event-form',
        title: 'Edit Event',
        backUrl: backToProductionUrl ?: '/admin/events',
        backLabel: backToProductionUrl ? 'Production' : 'Events',
        addNewUrl: '/admin/events/create',
        addNewLabel: 'Add New Event',
        viewUrl: the_permalink(event),
        deleteUrl: '/admin/events/' ~ event.id,
        deleteConfirm: 'Delete this event? This cannot be undone.'
    } %}

    <form id="event-form" action="/admin/events/edit" method="POST" class="space-y-6"
          hx-post="/admin/events/edit" hx-target="#flash-messages" hx-swap="innerHTML">
        <input type="hidden" name="eventId" value="{{ event.id }}" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div class="md:col-span-2">
                <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                <input type="text" name="title" id="title" maxlength="255"
                       value="{{ event.title }}"
                       placeholder="{{ event.production ? event.production.name : '' }}"
                       class="w-full rounded-md border-gray-300 shadow-sm">
                <p class="mt-1 text-xs text-gray-500">Leave blank to default to the production name. Suggested uses might include "Opening Night", "Audio Description", "Performance Plus Post-sahow Discussion" etc.</p>
            </div>

            <div>
                <label for="productionId" class="block text-sm font-medium text-gray-700 mb-1">Production</label>
                <select name="productionId" id="productionId" class="searchable-select w-full rounded-md border-gray-300 shadow-sm">
                    <option value="">None</option>
                    {% for p in productions %}
                        <option value="{{ p.id }}" {% if event.production and p.id == event.production.id %}selected{% endif %}>{{ p.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="venueId" class="block text-sm font-medium text-gray-700 mb-1">Venue</label>
                <select name="venueId" id="venueId" class="searchable-select w-full rounded-md border-gray-300 shadow-sm">
                    <option value="">None</option>
                    {% for v in venues %}
                        <option value="{{ v.id }}" {% if event.venue and v.id == event.venue.id %}selected{% endif %}>{{ v.name }}</option>
                    {% endfor %}
                </select>
                <p class="mt-1 text-xs text-gray-500">Leave blank to use the parent production's venue.</p>
            </div>

            <div>
                <label for="startsAt" class="block text-sm font-medium text-gray-700 mb-1">Starts At <span class="text-red-500">*</span></label>
                <input type="datetime-local" name="startsAt" id="startsAt" required
                       value="{{ event.startsAt ? event.startsAt|date('Y-m-d\\TH:i') : '' }}"
                       class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div>
                <label for="endsAt" class="block text-sm font-medium text-gray-700 mb-1">Ends At</label>
                <input type="datetime-local" name="endsAt" id="endsAt"
                       value="{{ event.endsAt ? event.endsAt|date('Y-m-d\\TH:i') : '' }}"
                       class="w-full rounded-md border-gray-300 shadow-sm">
                <p class="mt-1 text-xs text-gray-500">Optional.</p>
            </div>

            <div>
                <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                <select name="status" id="status" class="w-full rounded-md border-gray-300 shadow-sm">
                    <option value="scheduled" {% if event.status == 'scheduled' %}selected{% endif %}>Scheduled</option>
                    <option value="cancelled" {% if event.status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                    <option value="postponed" {% if event.status == 'postponed' %}selected{% endif %}>Postponed</option>
                </select>
            </div>

            <div class="md:col-span-2">
                <label for="ticketUrl" class="block text-sm font-medium text-gray-700 mb-1">Ticket URL</label>
                <input type="url" name="ticketUrl" id="ticketUrl" placeholder="https://example.com/tickets"
                       value="{{ event.ticketUrl }}"
                       class="w-full rounded-md border-gray-300 shadow-sm">
                <p class="mt-1 text-xs text-gray-500">Only set this if tickets for this specific performance are sold separately. Otherwise leave blank to use the parent production's ticket URL.</p>
            </div>

            <div class="md:col-span-2">
                <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                <textarea name="notes" id="notes" rows="4" class="w-full rounded-md border-gray-300 shadow-sm">{{ event.notes }}</textarea>
                <p class="mt-1 text-xs text-gray-500">Use this for more details or ad hoc information unique to this performance but not well suited for the title, e.g. understudies appearing in this performance, post-show discussion panelists, etc. Your theme <em>may</em> display these notes where appropriate.</p>
            </div>
        </div>

    </form>

{% endblock %}
