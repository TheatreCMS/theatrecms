{% extends 'layouts/admin.html.twig' %}

{% set base_url = '/' ~ content_type.adminSlug() %}
{% set form_action = base_url ~ '/create' %}

{% block title %}Create {{ content_type.singularLabel }} - {{ parent() }}{% endblock %}

{% block content %}
    {% include 'admin/partials/_edit_header.html.twig' with {
        formId: 'entry-form',
        title: 'Create New ' ~ content_type.singularLabel,
        backUrl: base_url,
        backLabel: content_type.label,
        submitLabel: 'Create ' ~ content_type.singularLabel,
        create: true
    } %}

    <form id="entry-form" action="{{ form_action }}" method="POST" class="space-y-6"
          hx-post="{{ form_action }}" hx-target="#flash-messages" hx-swap="innerHTML"
          hx-trigger="htmxSubmit">
        {% include 'admin/entries/_fields.html.twig' with {'entry': null} %}

    </form>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    {% include 'admin/entries/_form_scripts.html.twig' with {'content': null} %}
{% endblock %}
