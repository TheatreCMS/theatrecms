{#
    Form fields shared by the entry create and edit forms. Fields the content type doesn't
    support (content_type.supports(...)) are left out.

    Params:
      content_type  the ContentTypeDefinition
      entry         the Entry being edited, or null on the create form
      statuses      ContentStatus::labels()
#}
<div class="grid grid-cols-1 gap-6">
    <div>
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
        <input type="text" name="title" id="title" required maxlength="255" value="{{ entry.title|default('') }}"
               class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200">
    </div>

    <div>
        <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <select name="status" id="status" class="w-full rounded-md border-gray-300 shadow-sm">
            {% for key, label in statuses %}
                <option value="{{ key }}" {% if entry and key == entry.status.value %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
    </div>

    {% if entry %}
        <div>
            <label for="slug" class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
            <input type="text" name="slug" id="slug" maxlength="255" value="{{ entry.slug }}"
                   class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200">
        </div>

        <div>
            <label for="publishedAt" class="block text-sm font-medium text-gray-700 mb-1">Publish Date</label>
            <input type="datetime-local" name="publishedAt" id="publishedAt"
                   value="{{ entry.publishedAt ? entry.publishedAt|date('Y-m-d\\TH:i') : '' }}"
                   class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200">
        </div>
    {% endif %}

    {% if content_type.supports('featured_image') %}
        {% include 'admin/partials/_featured_image_field.html.twig' with {
            entityType: content_type.name,
            entityId: entry.id|default(null),
            deleteUrl: entry ? '/' ~ content_type.adminSlug() ~ '/' ~ entry.id ~ '/featured-image' : null,
            featuredImageUrl: entry ? entry.featuredImageUrl : null,
            featuredImageId: entry ? entry.featuredImage.id|default(null) : null
        } %}
    {% endif %}

    {% if content_type.supports('excerpt') %}
        <div>
            <label for="excerpt" class="block text-sm font-medium text-gray-700 mb-1">Excerpt</label>
            <textarea name="excerpt" id="excerpt" rows="3"
                      class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200">{{ entry ? entry.excerpt : '' }}</textarea>
        </div>
    {% endif %}

    {% if content_type.supports('editor') %}
        <div class="md:col-span-2 space-y-3">
            <label for="content" class="block text-sm font-medium text-gray-700">Content</label>
            <div id="editorjs" class="rounded-md border border-gray-200 bg-white shadow-sm"></div>
            <textarea name="content" id="content" rows="10" class="hidden" aria-hidden="true">{{ entry.content|default('') }}</textarea>
        </div>
    {% endif %}

    {% include 'admin/partials/_taxonomy_fields.html.twig' with {'content_type': content_type.name, 'content_id': entry.id|default(null)} %}
</div>
