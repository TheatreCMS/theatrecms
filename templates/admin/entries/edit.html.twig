{% extends 'layouts/admin.html.twig' %}

{% set base_url = '/' ~ content_type.adminSlug() %}
{% set form_action = base_url ~ '/edit' %}

{% block title %}Edit {{ content_type.singularLabel }} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Edit {{ content_type.singularLabel }}</h1>
    </div>

    <form action="{{ form_action }}" method="POST" class="space-y-6"
          hx-post="{{ form_action }}" hx-target="#flash-messages" hx-swap="innerHTML"
          hx-trigger="htmxSubmit">
        <input type="hidden" name="entryId" value="{{ entry.id }}">

        {% include 'admin/entries/_fields.html.twig' %}

        <div class="flex items-center justify-end space-x-3 pt-4 border-t">
            <a href="{{ base_url }}" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancel</a>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">Save Changes</button>
        </div>
    </form>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    {% include 'admin/entries/_form_scripts.html.twig' with {'content': entry.content} %}
{% endblock %}
