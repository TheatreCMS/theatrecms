{% extends 'layouts/admin.html.twig' %}

{% set base_url = '/' ~ content_type.adminSlug() %}
{% set form_action = base_url ~ '/edit' %}

{% block title %}Edit {{ content_type.singularLabel }} - {{ parent() }}{% endblock %}

{% block content %}
    {% include 'admin/partials/_edit_header.html.twig' with {
        formId: 'entry-form',
        title: 'Edit ' ~ content_type.singularLabel,
        backUrl: base_url,
        backLabel: content_type.label,
        addNewUrl: base_url ~ '/create',
        addNewLabel: 'Add New ' ~ content_type.singularLabel,
        viewUrl: content_type.public and entry.status.value == 'published' ? the_permalink(entry) : null,
        deleteUrl: base_url ~ '/' ~ entry.id,
        deleteConfirm: 'Delete this ' ~ content_type.singularLabel|lower ~ '? This cannot be undone.'
    } %}

    <form id="entry-form" action="{{ form_action }}" method="POST" class="space-y-6"
          hx-post="{{ form_action }}" hx-target="#flash-messages" hx-swap="innerHTML"
          hx-trigger="htmxSubmit">
        <input type="hidden" name="entryId" value="{{ entry.id }}">

        {% include 'admin/entries/_fields.html.twig' %}

    </form>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    {% include 'admin/entries/_form_scripts.html.twig' with {'content': entry.content} %}
{% endblock %}
