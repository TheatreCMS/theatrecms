{% if pagination.total > 0 %}
    <div class="flex flex-col gap-3 border-t border-default px-6 py-4 text-sm text-gray-600 md:flex-row md:items-center md:justify-between">
        <p>
            Showing {{ pagination.from }}-{{ pagination.to }} of {{ pagination.total }}
        </p>

        {% if pagination.pageCount > 1 %}
            <nav aria-label="Pagination" class="flex items-center gap-1">
                <a
                    href="{{ pagination.basePath }}?page={{ pagination.previousPage }}"
                    class="rounded border px-3 py-1.5 {% if pagination.hasPrevious %}text-gray-700 hover:bg-gray-50{% else %}pointer-events-none cursor-not-allowed text-gray-400{% endif %}">
                    Previous
                </a>

                {% for pageNumber in pagination.pages %}
                    <a
                        href="{{ pagination.basePath }}?page={{ pageNumber }}"
                        class="rounded border px-3 py-1.5 {% if pageNumber == pagination.page %}border-blue-600 bg-blue-600 text-white{% else %}text-gray-700 hover:bg-gray-50{% endif %}">
                        {{ pageNumber }}
                    </a>
                {% endfor %}

                <a
                    href="{{ pagination.basePath }}?page={{ pagination.nextPage }}"
                    class="rounded border px-3 py-1.5 {% if pagination.hasNext %}text-gray-700 hover:bg-gray-50{% else %}pointer-events-none cursor-not-allowed text-gray-400{% endif %}">
                    Next
                </a>
            </nav>
        {% endif %}
    </div>
{% endif %}
