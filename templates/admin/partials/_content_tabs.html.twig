{#
	Tab strip linking a content type's list to the pages for its taxonomies (e.g. "All works | Genres").
	Renders nothing when the user can't manage any of the content type's taxonomies.

	Params:
	  content_type  singular content-type key, e.g. 'work'
	  current       'list' on the content type's list page, otherwise the current taxonomy's name
#}
{% set content_type_lists = {
	work: { label: 'All works', url: '/admin/works' },
	post: { label: 'All posts', url: '/admin/posts' },
	production: { label: 'All productions', url: '/admin/productions' },
	season: { label: 'All seasons', url: '/admin/seasons' },
	event: { label: 'All events', url: '/admin/events' },
	person: { label: 'All people', url: '/admin/people' },
	venue: { label: 'All venues', url: '/admin/venues' },
	page: { label: 'All pages', url: '/admin/pages' },
} %}
{% set list = content_type_lists[content_type] ?? null %}
{% set tab_taxonomies = admin_taxonomies(content_type) %}

{% if list and tab_taxonomies is not empty %}
	{% set tab_class = 'inline-block px-4 py-2 -mb-px border-b-2 text-sm font-medium' %}
	{% set active_class = 'border-blue-600 text-blue-600' %}
	{% set inactive_class = 'border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300' %}
	<nav class="flex flex-wrap border-b mb-6" aria-label="Sections">
		<a href="{{ list.url }}" class="{{ tab_class }} {{ current == 'list' ? active_class : inactive_class }}" {% if current == 'list' %}aria-current="page"{% endif %}>{{ list.label }}</a>
		{% for taxonomy in tab_taxonomies %}
			<a href="/admin/taxonomies/{{ taxonomy.name }}" class="{{ tab_class }} {{ current == taxonomy.name ? active_class : inactive_class }}" {% if current == taxonomy.name %}aria-current="page"{% endif %}>{{ taxonomy.label }}</a>
		{% endfor %}
	</nav>
{% endif %}
