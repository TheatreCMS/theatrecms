{# Shared "Featured Image" field for Production/Post/Season/Venue create+edit forms.
   Params: entityType (string), entityId (int|null), featuredImageUrl (string|null), featuredImageId (int|null),
   oob (bool, optional) - set true when re-rendering this into an existing page via an HTMX out-of-band swap #}
<div id="featured-image-field"{% if oob %} hx-swap-oob="true"{% endif %} class="md:col-span-2">
    <label class="block text-sm font-medium text-gray-700 mb-1">Featured Image</label>
    <div class="rounded-md border border-gray-200 bg-gray-50 p-4">
        <div id="featured-image-preview">
            {% if featuredImageUrl %}
                <img src="{{ featuredImageUrl }}" alt="Featured image" class="max-h-40 w-auto object-contain">
            {% else %}
                <p class="text-sm text-gray-500">No featured image set.</p>
            {% endif %}
        </div>

        <div class="mt-3 flex items-center gap-3">
            <button
                type="button"
                class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                hx-get="/admin/images/picker?target={{ entityType }}"
                hx-target="#image-picker-modal-content"
                hx-swap="innerHTML"
            >
                Choose Image&hellip;
            </button>

            {% if entityId and featuredImageUrl %}
                <button
                    type="button"
                    class="px-3 py-1.5 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-md hover:bg-red-50"
                    hx-delete="/admin/{{ entityType }}s/{{ entityId }}/featured-image"
                    hx-target="#featured-image-field"
                    hx-swap="outerHTML"
                    hx-confirm="Remove the featured image? This does not delete it from the media library."
                >
                    Remove Featured Image
                </button>
            {% endif %}
        </div>
    </div>

    <input type="hidden" name="featuredImageId" id="featuredImageId" value="{{ featuredImageId }}">
</div>
