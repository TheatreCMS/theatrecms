<div id="workListContainer">
    <table class="w-full text-sm text-left rtl:text-right text-body">
        <thead class="text-sm text-body bg-neutral-secondary-soft border-b rounded-base border-default">
            <tr>
                <th scope="col" class="px-6 py-3 font-medium">Title</th>
                <th scope="col" class="px-6 py-3 font-medium">Author</th>
                <th scope="col" class="px-6 py-3 font-medium">Actions</th>
            </tr>
        </thead>
        <tbody id="workList">
            {% include 'admin/works/_table.html.twig' with {'works': works} %}
        </tbody>
    </table>

    {% include 'admin/partials/_pagination.html.twig' with {'pagination': pagination} %}
</div>
