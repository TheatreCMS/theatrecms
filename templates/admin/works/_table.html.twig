{% for work in works %}
    <tr class="bg-neutral-primary border-b border-default">
        <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
            {{ work.title }}
        </th>
        <td class="px-6 py-4">
            {{ work.creators.map(a => a.name)|join(', ') }}
        </td>
        <td class="px-6 py-4">
            <a href="/admin/works/edit/{{ work.id }}" class="text-blue-600 hover:text-blue-900 mr-4">Edit</a>
            <button
                type="button"
                class="text-red-600 hover:text-red-900"
                hx-delete="/admin/works/{{ work.id }}"
                hx-target="#workList">
                Delete
            </button>
        </td>
    </tr>
{% else %}
    <tr class="bg-neutral-primary border-b border-default">
        <td class="px-6 py-4" colspan="3">No works found.</td>
    </tr>
{% endfor %}

