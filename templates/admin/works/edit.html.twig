{% extends 'layouts/admin.html.twig' %}

{# Allow controllers to pass variables; if not present, set to empty arrays #}
{% set people = people|default([]) %}
{% set work = work|default(null) %}
{% set creatorEntries = creatorEntries|default([]) %}

{% block title %}Edit {{ work.title|default('Work') }} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Edit Work</h1>
    </div>

    {% if people is empty %}
        <div class="mb-4 rounded-md bg-yellow-50 p-4 border border-yellow-200">
            <div class="flex">
                <div class="flex-shrink-0">
                    <!-- exclamation icon -->
                    <svg class="h-5 w-5 text-yellow-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.681-1.36 3.446 0l5.516 9.8A1.75 1.75 0 0 1 16.016 16H3.984A1.75 1.75 0 0 1 2.74 12.899l5.517-9.8zM11 13a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-1-8a.75.75 0 0 0-.75.75v4.5a.75.75 0 0 0 1.5 0v-4.5A.75.75 0 0 0 10 5z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-yellow-800">No people available</h3>
                    <div class="mt-1 text-sm text-yellow-700">
                        There are no people in the system to attach as creators. You can add people from the People
                        section before assigning creators.
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <form action="/{{ base_path|default('') }}admin/works/edit" method="POST" class="space-y-6"
          hx-post="/{{ base_path|default('') }}admin/works/edit" hx-target="#flash-messages" hx-swap="innerHTML" hx-trigger="htmxSubmit">
        <input type="hidden" name="id" value="{{ work.id }}">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title <span class="text-red-500">*</span></label>
                <input type="text" name="title" id="title" required
                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                       placeholder="e.g. The Importance of Being Earnest" value="{{ work.title }}">
            </div>

            <div class="md:col-span-2">
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <div id="blocknote-holder" class="rounded-md border border-gray-200 bg-white shadow-sm min-h-[200px]"></div>
                <textarea name="description" id="description" class="hidden" aria-hidden="true">{{ work.description|default('') }}</textarea>
            </div>

            <div class="md:col-span-2">
                <label for="synopsis" class="block text-sm font-medium text-gray-700 mb-1">Synopsis</label>
                <textarea name="synopsis" id="synopsis" rows="6"
                          class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                          placeholder="A short synopsis or summary...">{{ work.synopsis|default('') }}</textarea>
            </div>

            <div class="md:col-span-2 space-y-4 p-6 border border-dashed border-gray-200 rounded-lg bg-gray-50">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900 mb-1">Creators</h2>
                        <p class="text-sm text-gray-600">Assign people to the work and define their role when needed.</p>
                    </div>
                    <button type="button"
                            id="add-creator"
                            class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 {% if people is empty %}opacity-50 cursor-not-allowed{% endif %}"
                            {% if people is empty %}disabled{% endif %}>
                        Add Creator
                    </button>
                </div>

                <div class="relative overflow-x-auto bg-white border border-gray-200 shadow-sm rounded-md">
                    <table class="w-full text-sm text-left text-gray-700">
                        <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 font-medium">Person</th>
                            <th class="px-4 py-3 font-medium">Role</th>
                            <th class="px-4 py-3 font-medium text-right">Action</th>
                        </tr>
                        </thead>
                        <tbody data-creator-rows>
                        {% if creatorEntries is not empty %}
                            {% for entry in creatorEntries %}
                                <tr class="bg-white border-b border-gray-100" data-creator-row>
                                    <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                        <select name="creatorIds[]" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                            <option value="">Select a person</option>
                                            {% for person in people %}
                                                <option value="{{ person.id }}" {% if person.id == entry.personId %}selected{% endif %}>{{ person.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </th>
                                    <td class="px-4 py-3">
                                        <label class="sr-only" for="creator-role-{{ loop.index0 }}">Role</label>
                                        <input type="text" name="creatorRoles[]" id="creator-role-{{ loop.index0 }}"
                                               value="{{ entry.role|default('') }}"
                                               class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                                               placeholder="Role (optional)">
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <a href="#" class="delete-creator font-medium text-blue-600 hover:underline">Delete</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr class="bg-white border-b border-gray-100" data-creator-row>
                                <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                    <select name="creatorIds[]" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                        <option value="">Select a person</option>
                                        {% for person in people %}
                                            <option value="{{ person.id }}">{{ person.name }}</option>
                                        {% endfor %}
                                    </select>
                                </th>
                                <td class="px-4 py-3">
                                    <label class="sr-only" for="creator-role-empty">Role</label>
                                    <input type="text" name="creatorRoles[]" id="creator-role-empty"
                                           class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                                           placeholder="Role (optional)">
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <a href="#" class="delete-creator font-medium text-blue-600 hover:underline">Delete</a>
                                </td>
                            </tr>
                        {% endif %}
                        <tr class="hidden bg-white border-b border-gray-100" data-creator-template>
                            <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                <select name="creatorIds[]" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                    <option value="">Select a person</option>
                                    {% for person in people %}
                                        <option value="{{ person.id }}">{{ person.name }}</option>
                                    {% endfor %}
                                </select>
                            </th>
                            <td class="px-4 py-3">
                                <label class="sr-only" for="creator-role-template">Role</label>
                                <input type="text" name="creatorRoles[]" id="creator-role-template"
                                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                                       placeholder="Role (optional)">
                            </td>
                            <td class="px-4 py-3 text-right">
                                <a href="#" class="delete-creator font-medium text-blue-600 hover:underline">Delete</a>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t">
            <a href="/{{ base_path|default('') }}admin/works"
               class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                Cancel
            </a>
            <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                Save Changes
            </button>
        </div>
    </form>

{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const titleInput = document.getElementById('title');

            const setupDynamicRows = (namespace) => {
                const rowsBody = document.querySelector(`tbody[data-${namespace}-rows]`);
                const templateRow = rowsBody ? rowsBody.querySelector(`tr[data-${namespace}-template]`) : null;
                const addButton = document.getElementById(`add-${namespace}`);

                if (!rowsBody || !templateRow) {
                    return;
                }

                const getVisibleRows = () => Array.from(rowsBody.querySelectorAll(`tr[data-${namespace}-row]`));

                const resetRowInputs = (row) => {
                    const select = row.querySelector('select');
                    if (select) {
                        select.value = '';
                    }
                    const input = row.querySelector('input[type="text"]');
                    if (input) {
                        input.value = '';
                    }
                };

                const attachDeleteHandler = (row) => {
                    const deleteLink = row.querySelector(`.delete-${namespace}`);
                    if (!deleteLink) {
                        return;
                    }

                    deleteLink.addEventListener('click', function (event) {
                        event.preventDefault();
                        const visibleRows = getVisibleRows();
                        if (visibleRows.length <= 1) {
                            resetRowInputs(row);
                            return;
                        }

                        row.remove();
                    });
                };

                const createRow = () => {
                    const newRow = templateRow.cloneNode(true);
                    newRow.removeAttribute(`data-${namespace}-template`);
                    newRow.setAttribute(`data-${namespace}-row`, '');
                    newRow.classList.remove('hidden');

                    const select = newRow.querySelector('select');
                    if (select) {
                        select.value = '';
                    }

                    const input = newRow.querySelector('input[type="text"]');
                    if (input) {
                        const newId = `${namespace}-role-${getVisibleRows().length}`;
                        input.id = newId;
                        input.value = '';
                        const label = newRow.querySelector('label');
                        if (label) {
                            label.setAttribute('for', newId);
                        }
                    }

                    return newRow;
                };

                getVisibleRows().forEach((row) => attachDeleteHandler(row));

                const ensureRowPresent = () => {
                    if (getVisibleRows().length === 0) {
                        const row = createRow();
                        if (row) {
                            attachDeleteHandler(row);
                            rowsBody.insertBefore(row, templateRow);
                        }
                    }
                };

                ensureRowPresent();

                if (addButton) {
                    addButton.addEventListener('click', function (event) {
                        event.preventDefault();
                        const row = createRow();
                        if (row) {
                            attachDeleteHandler(row);
                            rowsBody.insertBefore(row, templateRow);
                        }
                    });
                }
            };

            setupDynamicRows('creator');

            BlockNoteEditor.mountBlockNoteEditor({
                holderId: 'blocknote-holder',
                fieldId: 'description',
                initialData: document.getElementById('description')?.value ?? null,
            });

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!titleInput.value.trim()) {
                    alert('Please provide a title for the work.');
                    titleInput.focus();
                    return;
                }
                form.dispatchEvent(new Event('htmxSubmit'));
            });

            form.addEventListener('htmx:afterRequest', function () {
                document.getElementById('flash-messages')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
        });
    </script>
{% endblock %}