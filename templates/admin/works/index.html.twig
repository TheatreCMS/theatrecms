{% extends 'layouts/admin.html.twig' %}

{% block title %}Works - {{ parent() }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">Works</h1>
        <p class="text-gray-600">Manage works and bibliographic records.</p>
    </div>
    <div>
        <a href="/admin/works/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Add New Work</a>
    </div>
</div>

<table class="w-full text-sm text-left rtl:text-right text-body">
    <thead class="text-sm text-body bg-neutral-secondary-soft border-b rounded-base border-default">
        <tr>
            <th scope="col" class="px-6 py-3 font-medium">Title</th>
            <th scope="col" class="px-6 py-3 font-medium">Author</th>
            <th scope="col" class="px-6 py-3 font-medium">Actions</th>
        </tr>
    </thead>
    <tbody id="workList">
        {% include 'admin/works/_table.html.twig' %}
    </tbody>
</table>
{% endblock %}