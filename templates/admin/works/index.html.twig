{% extends 'layouts/admin.html.twig' %}

{% block title %}Works - {{ parent() }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">Works</h1>
        <p class="text-gray-600">Manage works and bibliographic records.</p>
    </div>
    <div>
        <a href="/admin/works/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Add New Work</a>
    </div>
</div>

<div class="mb-4">
    <input
        type="search"
        name="q"
        value="{{ pagination.search }}"
        placeholder="Search by title..."
        class="w-full max-w-sm rounded border border-default px-3 py-2 text-sm"
        hx-get="/admin/works"
        hx-trigger="input changed delay:300ms, search"
        hx-target="#workListContainer"
        hx-swap="outerHTML"
        hx-push-url="true">
</div>

{% include 'admin/works/_list.html.twig' with {'works': works, 'pagination': pagination} %}
{% endblock %}