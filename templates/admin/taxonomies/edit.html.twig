{% extends 'layouts/admin.html.twig' %}

{% block title %}Edit {{ term.name }} - {{ parent() }}{% endblock %}

{% block content %}
{% include 'admin/partials/_content_tabs.html.twig' with {'content_type': taxonomy.contentTypes|first, 'current': taxonomy.name} %}

<div class="mb-6">
    <a href="{{ basePath }}" class="text-sm text-blue-600 hover:text-blue-900">&larr; All {{ taxonomy.label|lower }}</a>
    <h1 class="text-2xl font-bold text-gray-800 mt-2">Edit {{ taxonomy.singularLabel|lower }}</h1>
</div>

<form action="{{ basePath }}/edit/{{ term.id }}" method="POST" class="space-y-6 max-w-2xl"
    hx-post="{{ basePath }}/edit/{{ term.id }}" hx-target="#flash-messages" hx-swap="innerHTML">
    {% include 'admin/taxonomies/_fields.html.twig' %}

    <div class="flex items-center justify-end space-x-3 pt-4 border-t">
        <a href="{{ basePath }}" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancel</a>
        <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">Save changes</button>
    </div>
</form>
{% endblock %}
