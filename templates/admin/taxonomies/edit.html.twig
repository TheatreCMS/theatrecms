{% extends 'layouts/admin.html.twig' %}

{% block title %}Edit {{ term.name }} - {{ parent() }}{% endblock %}

{% block content %}
{% include 'admin/partials/_content_tabs.html.twig' with {'content_type': taxonomy.contentTypes|first, 'current': taxonomy.name} %}

{% include 'admin/partials/_edit_header.html.twig' with {
    formId: 'term-form',
    title: 'Edit ' ~ taxonomy.singularLabel|lower,
    backUrl: basePath,
    backLabel: 'All ' ~ taxonomy.label|lower,
    viewUrl: taxonomy.hasArchive ? the_permalink(term) : null,
    deleteUrl: basePath ~ '/' ~ term.id,
    deleteConfirm: 'Delete this ' ~ taxonomy.singularLabel|lower ~ '? This cannot be undone.',
    atTop: false
} %}

<form id="term-form" action="{{ basePath }}/edit/{{ term.id }}" method="POST" class="space-y-6 max-w-2xl"
    hx-post="{{ basePath }}/edit/{{ term.id }}" hx-target="#flash-messages" hx-swap="innerHTML">
    {% include 'admin/taxonomies/_fields.html.twig' %}

</form>
{% endblock %}
