{% extends 'layouts/admin.html.twig' %}

{% block title %}Themes - {{ parent() }}{% endblock %}

{% block content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Themes</h1>
    <p class="text-gray-600">Choose the theme that controls how your public site looks.</p>
</div>

{% if activated %}
    {% include 'admin/partials/_alert.html.twig' with {
        type: 'success',
        message: '"' ~ activated.name ~ '" is now the active theme.',
    } %}
{% endif %}

{% if themes is empty %}
    <p class="text-gray-600">No themes are installed. Add a theme directory containing a <code>theme.json</code> under <code>www/themes</code>.</p>
{% else %}
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {% for theme in themes %}
            {% set is_active = theme.slug == active_theme %}
            <div class="flex flex-col bg-white rounded-lg shadow-sm border {% if is_active %}border-blue-500 ring-2 ring-blue-500{% else %}border-gray-200{% endif %}">
                <div class="h-40 bg-gray-100 rounded-t-lg overflow-hidden flex items-center justify-center">
                    {% if theme.screenshot %}
                        <img src="/themes/{{ theme.slug|url_encode }}/{{ theme.screenshot }}" alt="{{ theme.name }} screenshot" class="w-full h-full object-cover object-top">
                    {% else %}
                        <span class="text-4xl font-semibold text-gray-300">{{ theme.name|first|upper }}</span>
                    {% endif %}
                </div>

                <div class="flex flex-col flex-1 p-4">
                    <div class="flex items-start justify-between gap-2">
                        <h2 class="text-lg font-semibold text-gray-800">{{ theme.name }}</h2>
                        {% if is_active %}
                            <span class="shrink-0 px-2 py-0.5 text-xs font-medium text-blue-700 bg-blue-50 rounded-full">Active</span>
                        {% endif %}
                    </div>
                    <p class="text-xs text-gray-500 mb-2">
                        <code>{{ theme.slug }}</code>
                        {% if theme.version %} · v{{ theme.version }}{% endif %}
                        {% if theme.author %} · by {{ theme.author }}{% endif %}
                    </p>
                    {% if theme.description %}
                        <p class="text-sm text-gray-600 mb-4">{{ theme.description }}</p>
                    {% endif %}

                    <div class="mt-auto pt-2">
                        {% if not is_active %}
                            <form action="/admin/themes/activate" method="POST">
                                <input type="hidden" name="theme" value="{{ theme.slug }}">
                                <button type="submit"
                                        class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">
                                    Activate
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
