<div id="featured-image-section"{% if oob %} hx-swap-oob="true"{% endif %}>
    <label class="block text-sm font-medium text-gray-700 mb-1">Featured Image Preview</label>
    <div class="rounded-md border border-gray-200 bg-gray-50 p-4">
        {% if season.featuredImageUrl %}
            <img
                id="current-featured-image-preview"
                src="{{ season.featuredImageUrl }}"
                alt="Current featured image for {{ season.label }}"
                class="max-h-48 w-auto object-contain"
            >
            <div class="mt-3">
                <button
                    type="button"
                    class="px-3 py-1.5 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-md hover:bg-red-50"
                    hx-delete="/admin/seasons/{{ season.id }}/featured-image"
                    hx-target="#featured-image-section"
                    hx-swap="outerHTML"
                    hx-confirm="Remove the current featured image? This will permanently delete the image file from the server."
                >
                    Remove Featured Image
                </button>
            </div>
        {% else %}
            <p id="current-featured-image-placeholder" class="text-sm text-gray-500">No featured image set.</p>
        {% endif %}
        <img
            id="upload-featured-image-preview"
            src=""
            alt="Selected featured image preview"
            class="mt-3 hidden max-h-48 w-auto object-contain"
        >
    </div>
</div>
