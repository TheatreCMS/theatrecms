{% extends 'layouts/admin.html.twig' %}

{% block title %}Edit Season - {{ parent() }}{% endblock %}

{% block content %}
    {% set sponsorsList = sponsors|default([]) %}
    {% set existingSponsorships = season.sponsorships|default([]) %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Edit Season</h1>
        <p class="text-gray-600">Enter the changes for this season.</p>
    </div>

    <form action="/{{ base_path|default('') }}admin/seasons/edit" method="POST" enctype="multipart/form-data" class="space-y-6"
          hx-post="/{{ base_path|default('') }}admin/seasons/edit" hx-encoding="multipart/form-data" hx-target="#flash-messages" hx-swap="innerHTML" hx-trigger="htmxSubmit">
        {% include 'admin/seasons/_featured_image_url_field.html.twig' %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <label for="label" class="block text-sm font-medium text-gray-700 mb-1">Season Label <span class="text-red-500">*</span></label>
                <input type="text" name="label" id="label" required
                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                       placeholder="e.g. 2024-2025 Season" value="{{ season.label|default('') }}">
            </div>

            <div>
                <label for="startDate" class="block text-sm font-medium text-gray-700 mb-1">Start Date <span class="text-red-500">*</span></label>
                <input type="date" name="startDate" id="startDate" required
                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                       value="{{ season.startDate|date('Y-m-d')|default('') }}">
            </div>

            <div>
                <label for="endDate" class="block text-sm font-medium text-gray-700 mb-1">End Date <span class="text-red-500">*</span></label>
                <input type="date" name="endDate" id="endDate" required
                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                       value="{{ season.endDate|date('Y-m-d')|default('') }}">
            </div>

            <div class="md:col-span-2">
                <label for="overview" class="block text-sm font-medium text-gray-700 mb-1">Overview</label>
                <textarea name="overview" id="overview" rows="4"
                          class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                          placeholder="Brief description of the season...">{{ season.overview|default('') }}</textarea>
            </div>
            <input type="hidden" name="seasonId" value="{{ season.id|default(0) }}">

            <div class="md:col-span-2">
                <label for="featuredImage" class="block text-sm font-medium text-gray-700 mb-1">Upload Featured Image</label>
                <input type="file" name="featuredImage" id="featuredImage" accept="image/*" class="w-full rounded-md border-gray-300 shadow-sm">
                <p class="mt-1 text-xs text-gray-500">Uploading a file will replace the current featured image when saved.</p>
            </div>

            <div class="md:col-span-2">
                {% include 'admin/seasons/_featured_image_section.html.twig' %}
            </div>
        </div>

        <div class="space-y-4 p-6 border border-dashed border-gray-200 rounded-lg bg-gray-50">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-1">Sponsorships</h2>
                    <p class="text-sm text-gray-600">Manage the sponsors supporting this season.</p>
                </div>
                <button type="button"
                        id="add-sponsorship"
                        class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 {% if sponsorsList is empty %}opacity-50 cursor-not-allowed{% endif %}"
                        {% if sponsorsList is empty %}disabled{% endif %}>
                    Add Sponsorship
                </button>
            </div>

            {% if sponsorsList is empty %}
                <div class="rounded-md bg-yellow-50 border border-yellow-200 p-4 text-sm text-yellow-800">
                    There are no sponsors yet. Add sponsors from the Sponsors section before assigning them to a season.
                </div>
            {% else %}
                <div class="relative overflow-x-auto bg-white border border-gray-200 shadow-sm rounded-md">
                    <table class="w-full text-sm text-left text-gray-700">
                        <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 font-medium">Sponsor</th>
                            <th class="px-4 py-3 font-medium text-right">Action</th>
                        </tr>
                        </thead>
                        <tbody data-sponsorship-rows>
                        {% if existingSponsorships|length %}
                            {% for sponsorship in existingSponsorships %}
                                <tr class="bg-white border-b border-gray-100" data-sponsorship-row>
                                    <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                        <select name="sponsorshipSponsorIds[]" class="searchable-select w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                            <option value="">Select a sponsor</option>
                                            {% for sponsor in sponsorsList %}
                                                <option value="{{ sponsor.id }}" {% if sponsor.id == sponsorship.sponsor.id %}selected{% endif %}>
                                                    {{ sponsor.name }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </th>
                                    <td class="px-4 py-3 text-right">
                                        <a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr class="bg-white border-b border-gray-100" data-sponsorship-row>
                                <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                    <select name="sponsorshipSponsorIds[]" class="searchable-select w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                        <option value="">Select a sponsor</option>
                                        {% for sponsor in sponsorsList %}
                                            <option value="{{ sponsor.id }}">{{ sponsor.name }}</option>
                                        {% endfor %}
                                    </select>
                                </th>
                                <td class="px-4 py-3 text-right">
                                    <a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
                                </td>
                            </tr>
                        {% endif %}
                        <tr class="hidden bg-white border-b border-gray-100" data-sponsorship-template>
                            <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                <select name="sponsorshipSponsorIds[]" class="searchable-select w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                    <option value="">Select a sponsor</option>
                                    {% for sponsor in sponsorsList %}
                                        <option value="{{ sponsor.id }}">{{ sponsor.name }}</option>
                                    {% endfor %}
                                </select>
                            </th>
                            <td class="px-4 py-3 text-right">
                                <a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t">
            <a href="/{{ base_path|default('') }}admin/seasons"
               class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                Cancel
            </a>
            <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                Update Season
            </button>
        </div>
    </form>
{% endblock %}

{% block scripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');

            form.addEventListener('submit', function(event) {
                event.preventDefault();
                if (!startDateInput || !endDateInput) {
                    form.dispatchEvent(new Event('htmxSubmit'));
                    return;
                }

                const startDate = new Date(startDateInput.value);
                const endDate = new Date(endDateInput.value);

                if (endDate <= startDate) {
                    alert('The end date must be after the start date.');
                    endDateInput.focus();
                    return;
                }

                form.dispatchEvent(new Event('htmxSubmit'));
            });

            form.addEventListener('htmx:afterRequest', function() {
                document.getElementById('flash-messages')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });

            const setupDynamicRows = (namespace) => {
                const rowsBody = document.querySelector(`tbody[data-${namespace}-rows]`);
                const templateRow = rowsBody ? rowsBody.querySelector(`tr[data-${namespace}-template]`) : null;
                const addButton = document.getElementById(`add-${namespace}`);

                if (!rowsBody || !templateRow) {
                    return;
                }

                const getVisibleRows = () => Array.from(rowsBody.querySelectorAll(`tr[data-${namespace}-row]`));

                const resetRowInputs = (row) => {
                    const select = row.querySelector('select');
                    if (select) {
                        select.value = '';
                    }
                    const input = row.querySelector('input[type="text"]');
                    if (input) {
                        input.value = '';
                    }
                };

                const attachDeleteHandler = (row) => {
                    const deleteLink = row.querySelector(`.delete-${namespace}`);
                    if (!deleteLink) {
                        return;
                    }

                    deleteLink.addEventListener('click', function(event) {
                        event.preventDefault();
                        const visibleRows = getVisibleRows();
                        if (visibleRows.length <= 1) {
                            resetRowInputs(row);
                            return;
                        }

                        row.remove();
                    });
                };

                const createRow = () => {
                    const newRow = templateRow.cloneNode(true);
                    newRow.removeAttribute(`data-${namespace}-template`);
                    newRow.setAttribute(`data-${namespace}-row`, '');
                    newRow.classList.remove('hidden');

                    const select = newRow.querySelector('select');
                    if (select) {
                        select.value = '';
                    }

                    const input = newRow.querySelector('input[type="text"]');
                    if (input) {
                        const newId = `${namespace}-role-${getVisibleRows().length}`;
                        input.id = newId;
                        input.value = '';
                        const label = newRow.querySelector('label');
                        if (label) {
                            label.setAttribute('for', newId);
                        }
                    }

                    return newRow;
                };

                getVisibleRows().forEach((row) => attachDeleteHandler(row));

                const ensureRowPresent = () => {
                    if (getVisibleRows().length === 0) {
                        const row = createRow();
                        if (row) {
                            attachDeleteHandler(row);
                            rowsBody.insertBefore(row, templateRow);
                        }
                    }
                };

                ensureRowPresent();

                if (addButton) {
                    addButton.addEventListener('click', function(event) {
                        event.preventDefault();
                        const row = createRow();
                        if (row) {
                            attachDeleteHandler(row);
                            rowsBody.insertBefore(row, templateRow);
                        }
                    });
                }
            };

            setupDynamicRows('sponsorship');
        });
    </script>

    <script>
        (function () {
            var featuredImageInput = document.getElementById('featuredImage');
            var uploadPreview = document.getElementById('upload-featured-image-preview');
            var activeObjectUrl = null;

            if (!featuredImageInput || !uploadPreview) {
                return;
            }

            featuredImageInput.addEventListener('change', function (event) {
                var input = event.target;

                if (activeObjectUrl) {
                    URL.revokeObjectURL(activeObjectUrl);
                    activeObjectUrl = null;
                }

                if (!input || !input.files || input.files.length === 0) {
                    uploadPreview.src = '';
                    uploadPreview.classList.add('hidden');
                    return;
                }

                var file = input.files[0];
                if (!file.type || file.type.indexOf('image/') !== 0) {
                    uploadPreview.src = '';
                    uploadPreview.classList.add('hidden');
                    return;
                }

                activeObjectUrl = URL.createObjectURL(file);
                uploadPreview.src = activeObjectUrl;
                uploadPreview.classList.remove('hidden');
            });
        }());
    </script>
{% endblock %}
