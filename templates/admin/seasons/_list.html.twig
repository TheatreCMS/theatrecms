<div id="seasonListContainer">
    <table class="w-full text-sm text-left rtl:text-right text-body">
        <thead class="text-sm text-body bg-neutral-secondary-soft border-b rounded-base border-default">
            <tr>
                <th scope="col" class="px-6 py-3 font-medium">Name</th>
                <th scope="col" class="px-6 py-3 font-medium">Start Date</th>
                <th scope="col" class="px-6 py-3 font-medium">End Date</th>
                <th scope="col" class="px-6 py-3 font-medium">Actions</th>
            </tr>
        </thead>
        <tbody id="seasonList">
            {% include 'admin/seasons/_table.html.twig' with {'seasons': seasons} %}
        </tbody>
    </table>

    {% include 'admin/partials/_pagination.html.twig' with {'pagination': pagination} %}
</div>
