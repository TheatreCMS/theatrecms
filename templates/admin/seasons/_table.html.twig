{% for season in seasons %}
    <tr class="bg-neutral-primary border-b border-default">
        <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
            {{ season.label }}
        </th>
        <td class="px-6 py-4">
            {{ season.startDate ? season.startDate|date('M d, Y') : 'N/A' }}
        </td>
        <td class="px-6 py-4">
            {{ season.endDate ? season.endDate|date('M d, Y') : 'N/A' }}
        </td>
        <td class="px-6 py-4">
            <a href="/admin/seasons/edit/{{ season.id }}" class="text-blue-600 hover:text-blue-900 mr-4">Edit</a>
            <button
                type="button"
                class="text-red-600 hover:text-red-900"
                hx-delete="/admin/seasons/{{ season.id }}?page={{ pagination.page }}"
                hx-target="#seasonListContainer"
                hx-swap="outerHTML">
                Delete
            </button>
        </td>
    </tr>
{% else %}
    <tr class="bg-neutral-primary border-b border-default">
        <td class="px-6 py-4" colspan="4">No seasons found.</td>
    </tr>
{% endfor %}