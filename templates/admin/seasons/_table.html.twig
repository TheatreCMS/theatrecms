
{% for season in seasons %}
    <tr class="h-24 border-gray-300 border-b">
        <td class="text-sm pr-6 whitespace-no-wrap text-gray-800 tracking-normal leading-4 pl-8">
            {{ season.label }}
        </td>
        <td class="text-sm pr-6 whitespace-no-wrap text-gray-800 tracking-normal leading-4">
            {{ season.startDate ? season.startDate|date('M d, Y') : 'N/A' }}
        </td>
        <td class="text-sm pr-6 whitespace-no-wrap text-gray-800 tracking-normal leading-4">
            {{ season.endDate ? season.endDate|date('M d, Y') : 'N/A' }}
        </td>
        <td class="pr-8">
            <div class="flex items-center space-x-2">
                <a href="/admin/seasons/edit/{{ season.id }}" class="text-blue-600 hover:text-blue-900">Edit</a>
                <span class="text-gray-300">|</span>
                <button
                        type="button"
                        class="text-red-600 hover:text-red-900"
                        hx-delete="/admin/seasons/{{ season.id }}"
                        hx-target="#prodList">
                    Delete
                </button>
            </div>
        </td>
    </tr>
{% else %}
    <tr class="h-24 border-gray-300 border-b">
        <td colspan="4" class="text-sm text-gray-600 text-center">No seasons found.</td>
    </tr>
{% endfor %}