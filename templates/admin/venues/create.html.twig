{% extends 'layouts/admin.html.twig' %}

{% block title %}Create Venue - {{ parent() }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Create New Venue</h1>
        <p class="text-gray-600">Enter information for the new venue.</p>
    </div>

    <form action="/admin/venues/create" method="POST" class="space-y-6"
          hx-post="/admin/venues/create" hx-target="#flash-messages" hx-swap="innerHTML">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
                <input type="text" name="name" id="name" required class="w-full rounded-md border-gray-300 shadow-sm" placeholder="Venue name">
            </div>

            <div class="md:col-span-2">
                <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Address <span class="text-red-500">*</span></label>
                <input type="text" name="address" id="address" required class="w-full rounded-md border-gray-300 shadow-sm" placeholder="Street address">
            </div>

            <div>
                <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City <span class="text-red-500">*</span></label>
                <input type="text" name="city" id="city" required class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div>
                <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State <span class="text-red-500">*</span></label>
                <input type="text" name="state" id="state" required class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div>
                <label for="postcode" class="block text-sm font-medium text-gray-700 mb-1">Postcode <span class="text-red-500">*</span></label>
                <input type="text" name="postcode" id="postcode" required class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div>
                <label for="capacity" class="block text-sm font-medium text-gray-700 mb-1">Capacity</label>
                <input type="number" name="capacity" id="capacity" min="0" class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div class="md:col-span-2">
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea name="description" id="description" rows="4" class="w-full rounded-md border-gray-300 shadow-sm"></textarea>
            </div>

            <div class="md:col-span-2">
                <label for="accessibilityInfo" class="block text-sm font-medium text-gray-700 mb-1">Accessibility Info</label>
                <textarea name="accessibilityInfo" id="accessibilityInfo" rows="3" class="w-full rounded-md border-gray-300 shadow-sm"></textarea>
            </div>

            <div>
                <label for="websiteUrl" class="block text-sm font-medium text-gray-700 mb-1">Website URL</label>
                <input type="url" name="websiteUrl" id="websiteUrl" class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            <div>
                <label for="mapUrl" class="block text-sm font-medium text-gray-700 mb-1">Map URL</label>
                <input type="url" name="mapUrl" id="mapUrl" class="w-full rounded-md border-gray-300 shadow-sm">
            </div>

            {% include 'admin/partials/_featured_image_field.html.twig' with {
                entityType: 'venue', entityId: null, featuredImageUrl: null, featuredImageId: null
            } %}
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t">
            <a href="/admin/venues" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancel</a>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">Create Venue</button>
        </div>
    </form>

{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script type="module">
        import { initFeaturedImagePicker } from '/assets/js/featured-image-picker.js';
        initFeaturedImagePicker();
    </script>
    {% include 'admin/partials/_image_picker_modal.html.twig' %}
{% endblock %}
