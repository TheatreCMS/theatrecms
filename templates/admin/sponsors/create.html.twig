{% extends 'layouts/admin.html.twig' %}

{% block title %}Create Sponsor - {{ parent() }}{% endblock %}

{% block content %}
    {% include 'admin/partials/_edit_header.html.twig' with {
        formId: 'sponsor-form',
        title: 'Create New Sponsor',
        subtitle: 'Enter information for the new sponsor.',
        backUrl: '/admin/sponsors',
        backLabel: 'Sponsors',
        submitLabel: 'Create Sponsor',
        create: true
    } %}

    <form id="sponsor-form" action="/admin/sponsors/create" method="POST" class="space-y-6"
          hx-post="/admin/sponsors/create" hx-target="#flash-messages" hx-swap="innerHTML">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
                <input type="text" name="name" id="name" required class="w-full rounded-md border-gray-300 shadow-sm" placeholder="Sponsor name">
            </div>

            <div>
                <label for="logoUrl" class="block text-sm font-medium text-gray-700 mb-1">Logo URL</label>
                <input type="url" name="logoUrl" id="logoUrl" class="w-full rounded-md border-gray-300 shadow-sm" placeholder="https://example.com/logo.png">
            </div>

            <div>
                <label for="websiteUrl" class="block text-sm font-medium text-gray-700 mb-1">Website URL</label>
                <input type="url" name="websiteUrl" id="websiteUrl" class="w-full rounded-md border-gray-300 shadow-sm" placeholder="https://example.com">
            </div>
        </div>

    </form>

{% endblock %}

