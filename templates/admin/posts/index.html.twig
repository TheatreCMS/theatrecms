{% extends 'layouts/admin.html.twig' %}

{% block title %}Posts - {{ parent() }}{% endblock %}

{% block content %}
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">Posts</h1>
            <p class="text-gray-600">Create and manage blog-style posts.</p>
        </div>
        <div>
            <a href="/admin/posts/create" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded hover:bg-blue-700">Add New Post</a>
        </div>
    </div>

    <div class="mb-4">
        <input
            type="search"
            name="q"
            value="{{ pagination.search }}"
            placeholder="Search by title..."
            class="w-full max-w-sm rounded border border-default px-3 py-2 text-sm"
            hx-get="/admin/posts"
            hx-trigger="input changed delay:300ms, search"
            hx-target="#postListContainer"
            hx-swap="outerHTML"
            hx-push-url="true">
    </div>

    {% include 'admin/posts/_list.html.twig' with {'posts': posts, 'statuses': statuses, 'pagination': pagination} %}
{% endblock %}
