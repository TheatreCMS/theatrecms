{% extends 'layouts/admin.html.twig' %}

{% block title %}Posts - {{ parent() }}{% endblock %}

{% block content %}
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">Posts</h1>
            <p class="text-gray-600">Create and manage blog-style posts.</p>
        </div>
        <div>
            <a href="/admin/posts/create" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded hover:bg-blue-700">Add New Post</a>
        </div>
    </div>

    <div class="overflow-x-auto bg-white shadow-sm rounded">
        <table class="w-full text-sm text-left text-body">
            <thead class="text-sm text-body bg-neutral-secondary-soft border-b border-default">
            <tr>
                <th scope="col" class="px-6 py-3 font-medium">Title</th>
                <th scope="col" class="px-6 py-3 font-medium">Status</th>
                <th scope="col" class="px-6 py-3 font-medium">Slug</th>
                <th scope="col" class="px-6 py-3 font-medium text-right">Actions</th>
            </tr>
            </thead>
            <tbody id="postList">
            {% include 'admin/posts/_table.html.twig' with {'posts': posts, 'status_labels': statuses} %}
            </tbody>
        </table>
    </div>
{% endblock %}
