{% for post in posts %}
    <tr class="bg-neutral-primary border-b border-default">
        <td class="px-6 py-4">{{ post.title }}</td>
        <td class="px-6 py-4">{{ status_labels[post.status] ?? post.status }}</td>
        <td class="px-6 py-4">{{ post.slug }}</td>
        <td class="px-6 py-4 text-right space-x-2">
            <a href="/admin/posts/edit/{{ post.id }}" class="text-blue-600 hover:text-blue-900">Edit</a>
            <button type="button" class="text-red-600 hover:text-red-900" hx-delete="/admin/posts/{{ post.id }}" hx-target="#postList">Delete</button>
        </td>
    </tr>
{% else %}
    <tr class="bg-neutral-primary border-b border-default">
        <td class="px-6 py-4" colspan="4">No posts found.</td>
    </tr>
{% endfor %}
