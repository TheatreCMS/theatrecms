<div id="featured-image-section"{% if oob %} hx-swap-oob="true"{% endif %} class="md:col-span-2">
    <label for="poster" class="block text-sm font-medium text-gray-700 mb-1">Featured Image</label>
    <div class="rounded-md border border-gray-200 bg-gray-50 p-4">
        {% if production.hasFeaturedImage() %}
            <img
                id="current-featured-image-preview"
                src="{{ production.featuredImageUrl }}"
                alt="Featured image for {{ production.name }}"
                class="max-h-40 w-auto object-contain"
            >
            <div class="mt-3">
                <button
                    type="button"
                    class="px-3 py-1.5 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-md hover:bg-red-50"
                    hx-delete="/admin/productions/{{ production.id }}/featured-image"
                    hx-target="#featured-image-section"
                    hx-swap="outerHTML"
                    hx-confirm="Remove the current featured image? This will permanently delete the image file from the server."
                >
                    Remove Featured Image
                </button>
            </div>
        {% else %}
            <p id="current-featured-image-placeholder" class="text-sm text-gray-500">No featured image set.</p>
        {% endif %}

        <img
            id="upload-featured-image-preview"
            src=""
            alt="Selected featured image preview"
            class="mt-3 hidden max-h-40 w-auto object-contain"
        >
    </div>

    <input type="file" name="poster" id="poster" accept="image/*" class="mt-3 w-full rounded-md border-gray-300 shadow-sm">
    <p class="mt-1 text-xs text-gray-500">Uploading a file will replace the current featured image when saved.</p>
</div>
