{% extends 'layouts/admin.html.twig' %}

{% block title %}Productions - {{ parent() }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">Productions</h1>
        <p class="text-gray-600">Plays, concerts, operas....</p>
    </div>
    <div>
        {% if seasons is empty %}
            <span class="inline-block bg-blue-600 opacity-50 cursor-not-allowed text-white font-bold py-2 px-4 rounded"
                  aria-disabled="true"
                  title="Create a season first before you can create a production.">Create Production</span>
        {% else %}
            <a href="/admin/productions/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Create Production</a>
        {% endif %}
    </div>
</div>

{% if seasons is empty %}
    <div class="mb-6 rounded-md bg-blue-50 p-4 border border-blue-200">
        <div class="flex gap-3">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-blue-800">No seasons available</h3>
                <div class="mt-1 text-sm text-blue-700">A production must belong to a season. <a href="/admin/seasons" class="font-medium underline hover:text-blue-900">Create a season</a> before you can create a production.</div>
            </div>
        </div>
    </div>
{% endif %}

{% include 'admin/productions/_list.html.twig' with {'productions': productions, 'pagination': pagination} %}
{% endblock %}
