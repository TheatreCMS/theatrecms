{% extends 'layouts/admin.html.twig' %}

{# Allow controllers to pass variables; if not present, set to empty arrays #}
{% set seasons = seasons|default([]) %}
{% set people = people|default([]) %}
{% set works = works|default([]) %}
{% set performers = performers|default([]) %}
{% set sponsorsList = sponsors|default([]) %}
{% set venues = venues|default([]) %}
{% set existingSponsorships = production.sponsorships|default([]) %}
{% set editorDescription = production.description ? production.description|raw : null %}
{% set activeTab = activeTab|default('details') %}
{% set selectedWorkIds = [] %}
{% for selectedWork in production.works|default([]) %}
	{% set selectedWorkIds = selectedWorkIds|merge([selectedWork.id]) %}
{% endfor %}

{% block title %}Edit
	{{ production.name }}
	-
	{{ parent() }}
{% endblock %}

{% block content %}
	<div class="mb-6">
		<h1 class="text-2xl font-bold text-gray-800">Edit Production: <em>{{ production.name }}</em></h1>
	</div>

	{# ── Tab navigation ─────────────────────────────────────────────────────── #}
	<ul id="prod-tabs" class="flex flex-wrap text-sm font-medium text-center text-gray-500 border-b border-gray-200 mb-6" data-tabs-toggle="#prod-tab-content" role="tablist">
		<li class="me-2" role="presentation">
			<button id="tab-details-btn" data-tabs-target="#tab-details" type="button" role="tab" aria-controls="tab-details" aria-selected="{{ activeTab == 'details' ? 'true' : 'false' }}" class="inline-block p-4 border-b-2 rounded-t-lg {% if activeTab == 'details' %}border-blue-600 text-blue-600 active{% else %}border-transparent hover:text-gray-600 hover:border-gray-300{% endif %}">
				Production Details
			</button>
		</li>
		<li class="me-2" role="presentation">
			<button id="tab-works-btn" data-tabs-target="#tab-works" type="button" role="tab" aria-controls="tab-works" aria-selected="{{ activeTab == 'works' ? 'true' : 'false' }}" class="inline-block p-4 border-b-2 rounded-t-lg {% if activeTab == 'works' %}border-blue-600 text-blue-600 active{% else %}border-transparent hover:text-gray-600 hover:border-gray-300{% endif %}">
				Works
			</button>
		</li>
		<li class="me-2" role="presentation">
			<button id="tab-people-btn" data-tabs-target="#tab-people" type="button" role="tab" aria-controls="tab-people" aria-selected="{{ activeTab == 'people' ? 'true' : 'false' }}" class="inline-block p-4 border-b-2 rounded-t-lg {% if activeTab == 'people' %}border-blue-600 text-blue-600 active{% else %}border-transparent hover:text-gray-600 hover:border-gray-300{% endif %}">
				People
			</button>
		</li>
		<li class="me-2" role="presentation">
			<button id="tab-sponsors-btn" data-tabs-target="#tab-sponsors" type="button" role="tab" aria-controls="tab-sponsors" aria-selected="{{ activeTab == 'sponsors' ? 'true' : 'false' }}" class="inline-block p-4 border-b-2 rounded-t-lg {% if activeTab == 'sponsors' %}border-blue-600 text-blue-600 active{% else %}border-transparent hover:text-gray-600 hover:border-gray-300{% endif %}">
				Sponsors
			</button>
		</li>
		<li class="me-2" role="presentation">
			<button id="tab-performances-btn" data-tabs-target="#tab-performances" type="button" role="tab" aria-controls="tab-performances" aria-selected="{{ activeTab == 'performances' ? 'true' : 'false' }}" class="inline-block p-4 border-b-2 rounded-t-lg {% if activeTab == 'performances' %}border-blue-600 text-blue-600 active{% else %}border-transparent hover:text-gray-600 hover:border-gray-300{% endif %}">
				Performances
			</button>
		</li>
	</ul>

	{# ── Tab content container ───────────────────────────────────────────────── #}
	<div
		id="prod-tab-content">

		{# The main form wraps the first three tab panels so their fields are submitted together. #}
		<form action="/{{ base_path|default('') }}admin/productions/edit" method="POST" enctype="multipart/form-data" class="space-y-6" hx-post="/{{ base_path|default('') }}admin/productions/edit" hx-target="#flash-messages" hx-swap="innerHTML" hx-trigger="htmxSubmit">
			<input
			type="hidden" name="productionId" value="{{ production.id }}">

			{# ── Tab 1: Production Details ──────────────────────────────────── #}
			<div id="tab-details" role="tabpanel" aria-labelledby="tab-details-btn" class="{% if activeTab != 'details' %}hidden{% endif %}">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

					{% if seasons is empty %}
						<div class="md:col-span-2 rounded-md bg-yellow-50 p-4 border border-yellow-200">
							<div class="flex">
								<div class="flex-shrink-0">
									<svg class="h-5 w-5 text-yellow-600" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20" fill="currentColor" aria-hidden="true">
										<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.681-1.36 3.446 0l5.516 9.8A1.75 1.75 0 0 1 16.016 16H3.984A1.75 1.75 0 0 1 2.74 12.899l5.517-9.8zM11 13a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-1-8a.75.75 0 0 0-.75.75v4.5a.75.75 0 0 0 1.5 0v-4.5A.75.75 0 0 0 10 5z" clip-rule="evenodd"/>
									</svg>
								</div>
								<div class="ml-3">
									<h3 class="text-sm font-medium text-yellow-800">No seasons available</h3>
									<div class="mt-1 text-sm text-yellow-700">
										There are no seasons in the system. A production should belong to a season — create a season
										                                        from the Seasons section first.
									</div>
								</div>
							</div>
						</div>
					{% endif %}

					<div class="md:col-span-2">
						<label for="name" class="block text-sm font-medium text-gray-700 mb-1">Production Name
							<span class="text-red-500">*</span>
						</label>
						<input type="text" name="name" id="name" required class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" placeholder="e.g. Hamlet" value="{{ production.name }}">
					</div>

					<div class="md:col-span-2">
						<label for="seasonId" class="block text-sm font-medium text-gray-700 mb-1">Season
							<span class="text-red-500">*</span>
						</label>
						{% if seasons is not empty %}
							<select name="seasonId" id="seasonId" required class="searchable-select w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
								<option value="">Select a season</option>
								{% for s in seasons %}
									{% set selected = '' %}
									{% if s.id == production.season.id %}
										{% set selected = 'selected' %}
									{% endif %}
									<option value="{{ s.id }}" {{ selected }}>{{ s.label|default(s.slug|default(s.id)) }}</option>
								{% endfor %}
							</select>
						{% else %}
							<div class="text-xs text-gray-500 mt-1">No seasons available — create a season first from the Seasons section.</div>
						{% endif %}
					</div>

					<div class="md:col-span-2">
						<div class="flex items-center justify-between mb-1">
							<label for="venueId" class="block text-sm font-medium text-gray-700">Performance Venue</label>
							<button type="button"
							        class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100"
							        hx-get="/admin/venues/quick-create"
							        hx-target="#quick-create-modal-content"
							        hx-swap="innerHTML">
								+ New Venue
							</button>
						</div>
						<p class="text-xs text-gray-500 mb-2">Optional. Leave this blank if your organization only uses one performance space or if you do not need venue-level tracking.</p>
						{% if venues is empty %}
							<div id="venueId-empty-placeholder" class="text-xs text-gray-500 mt-1">No venues available. You can keep this production without a venue and assign one later.</div>
						{% else %}
							<select name="venueId" id="venueId" class="searchable-select w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
								<option value="">Select a venue</option>
								{% for v in venues %}
									<option value="{{ v.id }}" {% if production.venue and v.id == production.venue.id %} selected {% endif %}>
										{{ v.name }}
									</option>
								{% endfor %}
							</select>
						{% endif %}
					</div>

					<div class="md:col-span-2">
						<fieldset class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								<label for="opening" class="block text-sm font-medium text-gray-700 mb-1">Opening
									<span class="text-red-500">*</span>
								</label>
								<input type="date" name="opening" id="opening" required class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" value="{{ production.opening|date('Y-m-d') }}">
							</div>
							<div>
								<label for="closing" class="block text-sm font-medium text-gray-700 mb-1">Closing
									<span class="text-red-500">*</span>
								</label>
								<input type="date" name="closing" id="closing" required class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" value="{{ production.closing|date('Y-m-d') }}">
							</div>
						</fieldset>
					</div>

					<div class="md:col-span-2 space-y-3">
						<label for="description" class="block text-sm font-medium text-gray-700">Description</label>
						<div id="editorjs" class="rounded-md border border-gray-200 bg-white shadow-sm"></div>
						<textarea name="description" id="description" rows="6" class="hidden" aria-hidden="true">{{ production.description|default('') }}</textarea>
					</div>

					<div class="md:col-span-2">
						<label for="excerpt" class="block text-sm font-medium text-gray-700 mb-1">Excerpt</label>
						<textarea name="excerpt" id="excerpt" rows="3" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" placeholder="Short teaser or summary...">{{ production.excerpt }}</textarea>
					</div>


					<div>
						<label for="promoVideoUrl" class="block text-sm font-medium text-gray-700 mb-1">Promo Video URL</label>
						<input type="url" name="promoVideoUrl" id="promoVideoUrl" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" placeholder="https://example.com/video" value="{{ production.promoVideoUrl }}">
					</div>

					<div>
						<label for="ticketPurchaseUrl" class="block text-sm font-medium text-gray-700 mb-1">Ticket Purchase
							                            URL</label>
						<input type="url" name="ticketPurchaseUrl" id="ticketPurchaseUrl" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" placeholder="https://example.com/tickets" value="{{ production.ticketPurchaseUrl }}">
					</div>

					{% include 'admin/productions/_featured_image_section.html.twig' %}

				</div>
			</div>
			{# /tab-details #}

			{# ── Tab 2: Works ───────────────────────────────────────────────── #}
			<div id="tab-works" role="tabpanel" aria-labelledby="tab-works-btn" class="{% if activeTab != 'works' %}hidden{% endif %}">

				<div class="space-y-4 p-6 border border-dashed border-gray-200 rounded-lg bg-gray-50">
					<div class="flex items-start justify-between gap-4">
						<div>
							<h2 class="text-lg font-semibold text-gray-900 mb-1">Works Performed</h2>
							<p class="text-sm text-gray-600">Select the works performed as part of this production, in the order they should be listed (e.g. a one-act festival or a choir's setlist).</p>
						</div>
						<button type="button"
						        class="flex-shrink-0 inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100"
						        hx-get="/admin/works/quick-create"
						        hx-target="#quick-create-modal-content"
						        hx-swap="innerHTML">
							+ New Work
						</button>
					</div>

					{% if works is empty %}
						<div class="rounded-md bg-yellow-50 border border-yellow-200 p-4 text-sm text-yellow-800">
							No works in the system yet. Use the <strong>+ New Work</strong> button above to add one.
						</div>
					{% endif %}

					<div class="works-picker" data-works-picker aria-label="Works">
						<div class="flex flex-col sm:flex-row gap-3 items-start">
							<div class="flex-1 min-w-0 w-full flex flex-col border border-gray-300 rounded-md bg-white">
								<div class="p-2 border-b border-gray-200">
									<input type="search" placeholder="Search works…" aria-label="Search available works"
									       class="w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500"
									       data-works-search>
								</div>
								<ul class="flex-1 max-h-64 overflow-y-auto p-1 space-y-0.5" role="listbox" aria-multiselectable="true"
								    aria-label="Available works" data-works-available></ul>
								<p class="hidden p-3 text-sm text-gray-400 italic" data-works-available-empty>No matching works.</p>
							</div>

							<div class="flex-1 min-w-0 w-full flex flex-col border border-gray-300 rounded-md bg-white">
								<div class="p-2 border-b border-gray-200 text-xs font-medium text-gray-500 uppercase tracking-wide">
									Selected <span data-works-selected-count>(0)</span>
								</div>
								<ul class="flex-1 max-h-64 overflow-y-auto p-1 space-y-0.5" role="listbox" aria-multiselectable="true"
								    aria-label="Selected works" data-works-selected></ul>
								<p class="hidden p-3 text-sm text-gray-400 italic" data-works-selected-empty>No works assigned yet. Click or drag a work from the left.</p>
							</div>
						</div>
						<p class="mt-1 text-xs text-gray-500">Click, drag, or focus an item and press Enter to add or remove it. Drag items within Selected (or focus one and press Alt+&uarr;/Alt+&darr;) to reorder them.</p>
						<div class="sr-only" aria-live="polite" data-works-announcer></div>

						<select multiple="multiple" name="works[]" id="works" class="hidden" aria-hidden="true" tabindex="-1" data-works-source>
							{# Selected works first, in their saved display order, so the initial DOM order (which native
							   form submission relies on) matches production.works instead of the unordered fetchAll() below. #}
							{% for w in production.works|default([]) %}
								<option value="{{ w.id }}" selected>{{ w.title }}</option>
							{% endfor %}
							{% for w in works %}
								{% if w.id not in selectedWorkIds %}
									<option value="{{ w.id }}">{{ w.title }}</option>
								{% endif %}
							{% endfor %}
						</select>
					</div>
				</div>

			</div>
			{# /tab-works #}

			{# ── Tab 3: People ──────────────────────────────────────────────── #}
			<div id="tab-people" role="tabpanel" aria-labelledby="tab-people-btn" class="{% if activeTab != 'people' %}hidden{% endif %}">

				{% if people is empty %}
					<div class="mb-4 rounded-md bg-yellow-50 p-4 border border-yellow-200">
						<div class="flex items-start justify-between gap-4">
							<div class="flex gap-3">
								<div class="flex-shrink-0">
									<svg class="h-5 w-5 text-yellow-600" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20" fill="currentColor" aria-hidden="true">
										<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.681-1.36 3.446 0l5.516 9.8A1.75 1.75 0 0 1 16.016 16H3.984A1.75 1.75 0 0 1 2.74 12.899l5.517-9.8zM11 13a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-1-8a.75.75 0 0 0-.75.75v4.5a.75.75 0 0 0 1.5 0v-4.5A.75.75 0 0 0 10 5z" clip-rule="evenodd"/>
									</svg>
								</div>
								<div class="ml-3">
									<h3 class="text-sm font-medium text-yellow-800">No people available</h3>
									<div class="mt-1 text-sm text-yellow-700">There are no people in the system yet.</div>
								</div>
							</div>
							<button type="button"
							        class="flex-shrink-0 inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-yellow-800 bg-yellow-100 border border-yellow-300 rounded-md hover:bg-yellow-200"
							        onclick="document.body.dataset.qcPersonTarget = 'performer'"
							        hx-get="/admin/people/quick-create"
							        hx-target="#quick-create-modal-content"
							        hx-swap="innerHTML">
								+ Add First Person
							</button>
						</div>
					</div>
				{% endif %}

				<div
					class="space-y-6">
				{# Performers #}
					<div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base border border-default">
						<table class="w-full text-sm text-left rtl:text-right text-body">
							<thead class="text-sm text-body bg-neutral-secondary-medium border-b border-default-medium">
								<tr>
									<th scope="col" class="px-6 py-3 font-medium">
										Performers
									</th>
									<th scope="col" class="px-6 py-3 font-medium">
										Role
									</th>
									<th>
										<div class="flex items-center justify-end gap-2 px-2">
											<button type="button"
											        class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100"
											        onclick="document.body.dataset.qcPersonTarget = 'performer'"
											        hx-get="/admin/people/quick-create"
											        hx-target="#quick-create-modal-content"
											        hx-swap="innerHTML">
												+ New Person
											</button>
											<button type="button" id="add-performer" class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50">Add Performer</button>
										</div>
									</th>
								</tr>
							</thead>
							<tbody data-performer-rows>
								{% if performers is not empty %}
									{% for p in performers %}
										<tr class="bg-neutral-primary-soft border-b border-default" data-performer-row>
											<th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
												<select aria-label="Person" class="searchable-select w-full rounded-md border-gray-300 shadow-sm" name="performerIds[]">
													<option value="">Select a person</option>
													{% for person in people %}
														<option value="{{ person.id }}" {% if person.id == p.person.id %} selected {% endif %}>
															{{ person.name }}
														</option>
													{% endfor %}
												</select>
											</th>
											<td class="px-6 py-4">
												<label class="sr-only" for="performer-role-{{ loop.index0 }}">Role</label>
												<input class="w-full rounded-md border-gray-300 shadow-sm" type="text" id="performer-role-{{ loop.index0 }}" name="performerRoles[]" placeholder="e.g. Hamlet" value="{{ p.role }}">
											</td>
											<td class="px-6 py-4 text-right">
												<a href="#" class="delete-performer font-medium text-fg-brand hover:underline">Delete</a>
											</td>
										</tr>
									{% endfor %}
								{% endif %}
								<tr class="hidden bg-neutral-primary-soft border-b border-default" data-performer-template>
									<th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
											<select aria-label="Person" class="searchable-select w-full rounded-md border-gray-300 shadow-sm" name="performerIds[]">
											<option value="">Select a person</option>
											{% for p in people %}
												<option value="{{ p.id }}">{{ p.name }}</option>
											{% endfor %}
										</select>
									</th>
									<td class="px-6 py-4">
										<label class="sr-only" for="performer-role-template">Role</label>
										<input class="w-full rounded-md border-gray-300 shadow-sm" type="text" id="performer-role-template" name="performerRoles[]" placeholder="e.g. Hamlet">
									</td>
									<td class="px-6 py-4 text-right">
										<a href="#" class="delete-performer font-medium text-fg-brand hover:underline">Delete</a>
									</td>
								</tr>
							</tbody>
						</table>
					</div>

					{# Production Team #}
					<div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base border border-default">
						<table class="w-full text-sm text-left rtl:text-right text-body">
							<thead class="text-sm text-body bg-neutral-secondary-medium border-b border-default-medium">
								<tr>
									<th scope="col" class="px-6 py-3 font-medium">
										Production Team
									</th>
									<th scope="col" class="px-6 py-3 font-medium">
										Role
									</th>
									<th>
										<div class="flex items-center justify-end gap-2 px-2">
											<button type="button"
											        class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100"
											        onclick="document.body.dataset.qcPersonTarget = 'productionTeam'"
											        hx-get="/admin/people/quick-create"
											        hx-target="#quick-create-modal-content"
											        hx-swap="innerHTML">
												+ New Person
											</button>
											<button type="button" id="add-productionTeam" class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50">Add Member</button>
										</div>
									</th>
								</tr>
							</thead>
							<tbody data-productionTeam-rows>
								{% if productionTeam is empty %}
									<tr class="bg-neutral-primary-soft border-b border-default" data-productionTeam-row>
										<th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
											<select aria-label="Person" class="searchable-select w-full rounded-md border-gray-300 shadow-sm" name="productionTeamIds[]">
												<option value="">Select a person</option>
												{% for p in people %}
													<option value="{{ p.id }}">{{ p.name }}</option>
												{% endfor %}
											</select>
										</th>
										<td class="px-6 py-4">
											<label class="sr-only" for="productionTeam-role-empty">Role</label>
											<input class="w-full rounded-md border-gray-300 shadow-sm" type="text" id="productionTeam-role-empty" name="productionTeamRoles[]" placeholder="e.g. Director">
										</td>
										<td class="px-6 py-4 text-right">
											<a href="#" class="delete-productionTeam font-medium text-fg-brand hover:underline">Delete</a>
										</td>
									</tr>
								{% else %}
									{% for m in productionTeam %}
										<tr class="bg-neutral-primary-soft border-b border-default" data-productionTeam-row>
											<th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
												<select aria-label="Person" class="searchable-select w-full rounded-md border-gray-300 shadow-sm" name="productionTeamIds[]">
													<option value="">Select a person</option>
													{% for person in people %}
														<option value="{{ person.id }}" {% if person.id == m.person.id %} selected {% endif %}>
															{{ person.name }}
														</option>
													{% endfor %}
												</select>
											</th>
											<td class="px-6 py-4">
												<label class="sr-only" for="productionTeam-role-{{ loop.index0 }}">Role</label>
												<input class="w-full rounded-md border-gray-300 shadow-sm" type="text" id="productionTeam-role-{{ loop.index0 }}" name="productionTeamRoles[]" placeholder="e.g. Director" value="{{ m.role }}">
											</td>
											<td class="px-6 py-4 text-right">
												<a href="#" class="delete-productionTeam font-medium text-fg-brand hover:underline">Delete</a>
											</td>
										</tr>
									{% endfor %}
								{% endif %}
								<tr class="hidden bg-neutral-primary-soft border-b border-default" data-productionTeam-template>
									<th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
											<select aria-label="Person" class="searchable-select w-full rounded-md border-gray-300 shadow-sm" name="productionTeamIds[]">
											<option value="">Select a person</option>
											{% for p in people %}
												<option value="{{ p.id }}">{{ p.name }}</option>
											{% endfor %}
										</select>
									</th>
									<td class="px-6 py-4">
										<label class="sr-only" for="productionTeam-role-template">Role</label>
										<input class="w-full rounded-md border-gray-300 shadow-sm" type="text" id="productionTeam-role-template" name="productionTeamRoles[]" placeholder="e.g. Director">
									</td>
									<td class="px-6 py-4 text-right">
										<a href="#" class="delete-productionTeam font-medium text-fg-brand hover:underline">Delete</a>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

			</div>
			{# /tab-people #}

			{# ── Tab 4: Sponsors ────────────────────────────────────────────── #}
			<div id="tab-sponsors" role="tabpanel" aria-labelledby="tab-sponsors-btn" class="{% if activeTab != 'sponsors' %}hidden{% endif %}">

				<div class="space-y-4 p-6 border border-dashed border-gray-200 rounded-lg bg-gray-50">
					<div class="flex items-start justify-between gap-4">
						<div>
							<h2 class="text-lg font-semibold text-gray-900 mb-1">Production Sponsorships</h2>
							<p class="text-sm text-gray-600">Select sponsors that are attached to this production.</p>
						</div>
						<div class="flex items-center gap-2">
							<button type="button"
							        class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100"
							        hx-get="/admin/sponsors/quick-create"
							        hx-target="#quick-create-modal-content"
							        hx-swap="innerHTML">
								+ New Sponsor
							</button>
							<button type="button" id="add-sponsorship" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 {% if sponsorsList is empty %}opacity-50 cursor-not-allowed{% endif %}" {% if sponsorsList is empty %} disabled {% endif %}>
								Add Sponsorship
							</button>
						</div>
					</div>

					{% if sponsorsList is empty %}
						<div id="sponsorship-empty-placeholder" class="rounded-md bg-yellow-50 border border-yellow-200 p-4 text-sm text-yellow-800">
							No sponsors yet. Use the <strong>+ New Sponsor</strong> button above to add one.
						</div>
					{% else %}
						<div class="relative overflow-x-auto bg-white border border-gray-200 shadow-sm rounded-md">
							<table class="w-full text-sm text-left text-gray-700">
								<thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 border-b border-gray-200">
									<tr>
										<th class="px-4 py-3 font-medium">Sponsor</th>
										<th class="px-4 py-3 font-medium text-right">Action</th>
									</tr>
								</thead>
								<tbody data-sponsorship-rows>
									{% if existingSponsorships|length %}
										{% for sponsorship in existingSponsorships %}
											<tr class="bg-white border-b border-gray-100" data-sponsorship-row>
												<th scope="row" class="px-4 py-3 font-medium text-gray-900">
												<select name="sponsorshipSponsorIds[]" class="searchable-select w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
														<option value="">Select a sponsor</option>
														{% for sponsor in sponsorsList %}
															<option value="{{ sponsor.id }}" {% if sponsor.id == sponsorship.sponsor.id %} selected {% endif %}>
																{{ sponsor.name }}
															</option>
														{% endfor %}
													</select>
												</th>
												<td class="px-4 py-3 text-right">
													<a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
												</td>
											</tr>
										{% endfor %}
									{% else %}
										<tr class="bg-white border-b border-gray-100" data-sponsorship-row>
											<th scope="row" class="px-4 py-3 font-medium text-gray-900">
												<select name="sponsorshipSponsorIds[]" class="searchable-select w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
													<option value="">Select a sponsor</option>
													{% for sponsor in sponsorsList %}
														<option value="{{ sponsor.id }}">{{ sponsor.name }}</option>
													{% endfor %}
												</select>
											</th>
											<td class="px-4 py-3 text-right">
												<a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
											</td>
										</tr>
									{% endif %}
									<tr class="hidden bg-white border-b border-gray-100" data-sponsorship-template>
										<th scope="row" class="px-4 py-3 font-medium text-gray-900">
											<select name="sponsorshipSponsorIds[]" class="searchable-select w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
												<option value="">Select a sponsor</option>
												{% for sponsor in sponsorsList %}
													<option value="{{ sponsor.id }}">{{ sponsor.name }}</option>
												{% endfor %}
											</select>
										</th>
										<td class="px-4 py-3 text-right">
											<a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>

			</div>
			{# /tab-sponsors #}

			{# ── Save / Cancel (visible for tabs 1–3, hidden on Performances tab) #}
			<div id="form-actions" class="flex items-center justify-end space-x-3 pt-4 border-t {% if activeTab == 'performances' %}hidden{% endif %}">
				<a href="/{{ base_path|default('') }}admin/productions" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
					Cancel
				</a>
				<button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
					Save Changes
				</button>
			</div>

		</form>

		{# ── Tab 5: Performances (outside the main form — has its own HTMX forms) #}
		<div id="tab-performances" role="tabpanel" aria-labelledby="tab-performances-btn" class="{% if activeTab != 'performances' %}hidden{% endif %}">
			{% include 'admin/productions/_events.html.twig' with {
                events: events|default([]),
                venues: venues,
                productionId: production.id,
                production: production
            } %}
		</div>
		{# /tab-performances #}

	</div>
	{# /prod-tab-content #}
	<script type="module">
		import {buildEditorJsConfig} from '/assets/js/editorjs-config.js';

document.addEventListener('DOMContentLoaded', function () { // Hide Save/Cancel when the Performances tab is active
const formActions = document.getElementById('form-actions');
document.querySelectorAll('#prod-tabs [data-tabs-target]').forEach(function (btn) {
btn.addEventListener('click', function () {
const isPerformances = btn.getAttribute('data-tabs-target') === '#tab-performances';
formActions.classList.toggle('hidden', isPerformances);
});
});

const currentUrl = new URL(window.location.href);
if (window.location.hash === '#performances' || currentUrl.searchParams.get('tab') === 'performances') {
    document.getElementById('tab-performances-btn').click();
    history.replaceState(null, '', window.location.pathname + window.location.search);
}
const form = document.querySelector('form');
const nameInput = document.getElementById('name');
const seasonInput = document.getElementById('seasonId');
const descriptionField = document.getElementById('description');
const posterInput = document.getElementById('poster');
const uploadFeaturedImagePreview = document.getElementById('upload-featured-image-preview');

const editorData = {{ editorDescription is not null ? editorDescription|raw : 'null' }};

const setupDynamicRows = (namespace, options) => {
const requireMinimumRow = !options || options.requireMinimumRow !== false;
const rowsBody = document.querySelector (`tbody[data-${namespace}-rows]`);
const templateRow = rowsBody ? rowsBody.querySelector (`tr[data-${namespace}-template]`) : null;
const addButton = document.getElementById (`add-${namespace}`);

if (! rowsBody || ! templateRow) {
return;
}

const getVisibleRows = () => Array.from(rowsBody.querySelectorAll (`tr[data-${namespace}-row]`));

const resetRowInputs = (row) => {
const select = row.querySelector('select');
if (select) {
select.value = '';
}
const input = row.querySelector('input[type="text"]');
if (input) {
input.value = '';
}
};

const attachDeleteHandler = (row) => {
const deleteLink = row.querySelector (`.delete-${namespace}`);
if (! deleteLink) {
return;
}

deleteLink.addEventListener('click', function (event) {
event.preventDefault();
const visibleRows = getVisibleRows();
if (requireMinimumRow && visibleRows.length<= 1) {
                                resetRowInputs(row);
                                return;
                            }

                            row.remove();
                        });
                    };

                    const createRow = () => {
const newRow = templateRow.cloneNode(true);
newRow.removeAttribute (`data-${namespace}-template`);
newRow.setAttribute (`data-${namespace}-row`, '');
newRow.classList.remove('hidden');

// Named inputs are the row's own fields (e.g. role text); the searchable-select
// widget's generated text box has no name, so this reliably finds the former
// even before/after that widget exists on the row.
const input = newRow.querySelector('input[type="text"][name]');
if (input) {
const newId = `${namespace}-role-${
getVisibleRows().length
}`;
input.id = newId;
input.value = '';
const label = newRow.querySelector('label');
if (label) {
label.setAttribute('for', newId);
}
}

const select = newRow.querySelector('select');
if (select) {
select.value = '';
// The cloned <select> carries the template's HTML but none of the searchable
// widget's event listeners (cloneNode never copies those), so typing/picking
// a value here would silently do nothing without re-enhancing it fresh.
if (window.enhanceSearchableSelect) {
window.enhanceSearchableSelect(select);
}
}

return newRow;
};

getVisibleRows().forEach((row) => attachDeleteHandler(row));

const ensureRowPresent =() => {
if (getVisibleRows().length === 0) {
const row = createRow();
if (row) {
attachDeleteHandler(row);
rowsBody.insertBefore(row, templateRow);
}
}
};

if (requireMinimumRow) {
ensureRowPresent();
}

if (addButton) {
addButton.addEventListener('click', function (event) {
event.preventDefault();
const row = createRow();
if (row) {
attachDeleteHandler(row);
rowsBody.insertBefore(row, templateRow);
}
});
}
};

setupDynamicRows('performer', {requireMinimumRow: false});
setupDynamicRows('productionTeam');
setupDynamicRows('sponsorship');

if (posterInput && uploadFeaturedImagePreview) {
let activeObjectUrl = null;

posterInput.addEventListener('change', function (event) {
const input = event.target;

if (activeObjectUrl) {
URL.revokeObjectURL(activeObjectUrl);
activeObjectUrl = null;
}

if (!input || !input.files || input.files.length === 0) {
uploadFeaturedImagePreview.src = '';
uploadFeaturedImagePreview.classList.add('hidden');
return;
}

const file = input.files[0];
if (!file.type || file.type.indexOf('image/') !== 0) {
uploadFeaturedImagePreview.src = '';
uploadFeaturedImagePreview.classList.add('hidden');
return;
}

activeObjectUrl = URL.createObjectURL(file);
uploadFeaturedImagePreview.src = activeObjectUrl;
uploadFeaturedImagePreview.classList.remove('hidden');
});
}

let isSaving = false;
form.addEventListener('submit', function (event) {
event.preventDefault();

if (! nameInput.value.trim()) {
alert('Please provide a production name.');
nameInput.focus();
return;
}

if (! seasonInput || ! seasonInput.value) {
alert('Please select or enter a season for the production.');
if (seasonInput)
seasonInput.focus();

return;
}

if (isSaving)
return;

isSaving = true;

editor.save().then(function (outputData) {
descriptionField.value = JSON.stringify(outputData);
form.dispatchEvent(new Event('htmxSubmit'));
}).catch(function (error) {
console.error('EditorJS save failed:', error);
document.getElementById('flash-messages').innerHTML = '<div id="form-alert" role="alert" class="flex items-center gap-3 p-4 mb-4 rounded-lg border bg-red-50 border-red-200 text-red-800">' + '<p class="text-sm font-medium">Unable to save description. Please try again.</p></div>';
isSaving = false;
});
});

form.addEventListener('htmx:afterRequest', function (event) {
// This listener is attached to the form to catch its own hx-post submission,
// but htmx:afterRequest bubbles from any descendant — including the "+ New …"
// quick-create buttons nested inside this form. Ignore those so quick-create
// clicks don't yank the page up to #flash-messages.
if (event.detail && event.detail.elt !== form) {
return;
}
isSaving = false;
document.getElementById('flash-messages') ?. scrollIntoView({behavior: 'smooth', block: 'nearest'});
});

const editor = new EditorJS(buildEditorJsConfig({
holder: 'editorjs',
data: editorData,
imageEndpoints: {
byFile: '/admin/productions/images/upload',
byUrl: '/admin/productions/images/fetch'
}
}));
});
</script>
<script type="module">
	import {initQuickCreateHandlers, buildVenueFallback, buildSponsorshipTableFallback} from '/assets/js/production-quick-create.js';

	initQuickCreateHandlers({
		person: {
			type: 'rowset-group',
			contextAttr: 'qcPersonTarget',
			candidates: [
				{namespace: 'performer', selectName: 'performerIds[]'},
				{namespace: 'productionTeam', selectName: 'productionTeamIds[]'},
			],
		},
		work: {type: 'multiselect', id: 'works'},
		venue: {type: 'single', selectName: 'venueId', buildFallback: buildVenueFallback},
		sponsor: {type: 'rowset', namespace: 'sponsorship', selectName: 'sponsorshipSponsorIds[]', buildFallback: buildSponsorshipTableFallback},
	});
</script>
<script src="/assets/js/works-picker.js"></script>

{% include 'admin/productions/_quick_create_modal.html.twig' %}
{% endblock %}
