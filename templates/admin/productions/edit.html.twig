{% extends 'layouts/admin.html.twig' %}

{# Allow controllers to pass variables; if not present, set to empty arrays #}
{% set seasons = seasons|default([]) %}
{% set people = people|default([]) %}
{% set works = works|default([]) %}
{% set creatives = creatives|default([]) %}
{% set performers = performers|default([]) %}
{% set sponsorsList = sponsors|default([]) %}
{% set venues = venues|default([]) %}
{% set existingSponsorships = production.sponsorships|default([]) %}
{% set editorDescription = production.description ? production.description|raw : null %}

{% block title %}Edit {{ production.name }} - {{ parent() }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Edit Production</h1>
    </div>

    {# ── Tab navigation ─────────────────────────────────────────────────────── #}
    <ul id="prod-tabs"
        class="flex flex-wrap text-sm font-medium text-center text-gray-500 border-b border-gray-200 mb-6"
        data-tabs-toggle="#prod-tab-content"
        role="tablist">
        <li class="me-2" role="presentation">
            <button id="tab-details-btn"
                    data-tabs-target="#tab-details"
                    type="button"
                    role="tab"
                    aria-controls="tab-details"
                    aria-selected="true"
                    class="inline-block p-4 border-b-2 border-blue-600 text-blue-600 rounded-t-lg active">
                Production Details
            </button>
        </li>
        <li class="me-2" role="presentation">
            <button id="tab-people-btn"
                    data-tabs-target="#tab-people"
                    type="button"
                    role="tab"
                    aria-controls="tab-people"
                    aria-selected="false"
                    class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300">
                People
            </button>
        </li>
        <li class="me-2" role="presentation">
            <button id="tab-sponsors-btn"
                    data-tabs-target="#tab-sponsors"
                    type="button"
                    role="tab"
                    aria-controls="tab-sponsors"
                    aria-selected="false"
                    class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300">
                Sponsors
            </button>
        </li>
        <li class="me-2" role="presentation">
            <button id="tab-performances-btn"
                    data-tabs-target="#tab-performances"
                    type="button"
                    role="tab"
                    aria-controls="tab-performances"
                    aria-selected="false"
                    class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300">
                Performances
            </button>
        </li>
    </ul>

    {# ── Tab content container ───────────────────────────────────────────────── #}
    <div id="prod-tab-content">

        {# The main form wraps the first three tab panels so their fields are submitted together. #}
        <form action="/{{ base_path|default('') }}admin/productions/edit" method="POST" enctype="multipart/form-data"
              class="space-y-6"
              hx-post="/{{ base_path|default('') }}admin/productions/edit" hx-target="#flash-messages" hx-swap="innerHTML" hx-trigger="htmxSubmit">
            <input type="hidden" name="productionId" value="{{ production.id }}">

            {# ── Tab 1: Production Details ──────────────────────────────────── #}
            <div id="tab-details" role="tabpanel" aria-labelledby="tab-details-btn">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    {% if seasons is empty %}
                        <div class="md:col-span-2 rounded-md bg-yellow-50 p-4 border border-yellow-200">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <svg class="h-5 w-5 text-yellow-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                         fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd"
                                              d="M8.257 3.099c.765-1.36 2.681-1.36 3.446 0l5.516 9.8A1.75 1.75 0 0 1 16.016 16H3.984A1.75 1.75 0 0 1 2.74 12.899l5.517-9.8zM11 13a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-1-8a.75.75 0 0 0-.75.75v4.5a.75.75 0 0 0 1.5 0v-4.5A.75.75 0 0 0 10 5z"
                                              clip-rule="evenodd"/>
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <h3 class="text-sm font-medium text-yellow-800">No seasons available</h3>
                                    <div class="mt-1 text-sm text-yellow-700">
                                        There are no seasons in the system. A production should belong to a season — create a season
                                        from the Seasons section first.
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {% if works is empty %}
                        <div class="md:col-span-2 rounded-md bg-yellow-50 p-4 border border-yellow-200">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <svg class="h-5 w-5 text-yellow-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                         fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd"
                                              d="M8.257 3.099c.765-1.36 2.681-1.36 3.446 0l5.516 9.8A1.75 1.75 0 0 1 16.016 16H3.984A1.75 1.75 0 0 1 2.74 12.899l5.517-9.8zM11 13a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-1-8a.75.75 0 0 0-.75.75v4.5a.75.75 0 0 0 1.5 0v-4.5A.75.75 0 0 0 10 5z"
                                              clip-rule="evenodd"/>
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <h3 class="text-sm font-medium text-yellow-800">No works available</h3>
                                    <div class="mt-1 text-sm text-yellow-700">
                                        There are no works in the system to attach to this production. You can add works from the Works
                                        section before creating a production.
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <div class="md:col-span-2">
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Production Name <span
                                    class="text-red-500">*</span></label>
                        <input type="text" name="name" id="name" required
                               class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                               placeholder="e.g. Hamlet" value="{{ production.name }}">
                    </div>

                    <div class="md:col-span-2">
                        <label for="seasonId" class="block text-sm font-medium text-gray-700 mb-1">Season <span
                                    class="text-red-500">*</span></label>
                        {% if seasons is not empty %}
                            <select name="seasonId" id="seasonId" required
                                    class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                <option value="">Select a season</option>
                                {% for s in seasons %}
                                    {% set selected = '' %}
                                    {% if s.id == production.season.id %}
                                        {% set selected = 'selected' %}
                                    {% endif %}
                                    <option value="{{ s.id }}" {{ selected }}>{{ s.label|default(s.slug|default(s.id)) }}</option>
                                {% endfor %}
                            </select>
                        {% else %}
                            <div class="text-xs text-gray-500 mt-1">No seasons available — create a season first from the Seasons section.</div>
                        {% endif %}
                    </div>

                    <div class="md:col-span-2">
                        <label for="venueId" class="block text-sm font-medium text-gray-700 mb-1">Venue <span class="text-red-500">*</span></label>
                        {% if venues is empty %}
                            <div class="text-xs text-gray-500 mt-1">No venues available. Add a venue from the Venues section before assigning productions.</div>
                        {% else %}
                            <select name="venueId" id="venueId" required
                                    class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                <option value="">Select a venue</option>
                                {% for v in venues %}
                                    <option value="{{ v.id }}" {% if production.venue and v.id == production.venue.id %}selected{% endif %}>
                                        {{ v.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        {% endif %}
                    </div>

                    <div class="md:col-span-2">
                        <fieldset class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="opening" class="block text-sm font-medium text-gray-700 mb-1">Opening <span
                                            class="text-red-500">*</span></label>
                                <input type="date" name="opening" id="opening" required
                                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                                       value="{{ production.opening|date('Y-m-d') }}">
                            </div>
                            <div>
                                <label for="closing" class="block text-sm font-medium text-gray-700 mb-1">Closing <span
                                            class="text-red-500">*</span></label>
                                <input type="date" name="closing" id="closing" required
                                       class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                                       value="{{ production.closing|date('Y-m-d') }}">
                            </div>
                        </fieldset>
                    </div>

                    <div class="md:col-span-2 space-y-3">
                        <label for="description" class="block text-sm font-medium text-gray-700">Description</label>
                        <div id="blocknote-holder" class="rounded-md border border-gray-200 bg-white shadow-sm min-h-[200px]"></div>
                        <textarea name="description" id="description" rows="6" class="hidden" aria-hidden="true">{{ production.description|default('') }}</textarea>
                    </div>

                    <div class="md:col-span-2">
                        <label for="excerpt" class="block text-sm font-medium text-gray-700 mb-1">Excerpt</label>
                        <textarea name="excerpt" id="excerpt" rows="3"
                                  class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                                  placeholder="Short teaser or summary...">{{ production.excerpt }}</textarea>
                    </div>

                    <div>
                        <label for="runtime" class="block text-sm font-medium text-gray-700 mb-1">Runtime (minutes)</label>
                        <input type="number" name="runtime" id="runtime" min="0"
                               class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                               placeholder="e.g. 120" value="{{ production.runtime > 0 ? production.runtime : '' }}">
                    </div>

                    <div>
                        <label for="ageRecommendation" class="block text-sm font-medium text-gray-700 mb-1">Age
                            Recommendation</label>
                        <input type="text" name="ageRecommendation" id="ageRecommendation"
                               class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                               placeholder="e.g. PG-13, All Ages" value="{{ production.ageRecommendation }}">
                    </div>

                    <div class="md:col-span-2">
                        <label for="contentAdvisory" class="block text-sm font-medium text-gray-700 mb-1">Content
                            Advisory</label>
                        <textarea name="contentAdvisory" id="contentAdvisory" rows="3"
                                  class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                                  placeholder="Notes about sensitive content...">{{ production.contentAdvisory }}</textarea>
                    </div>

                    <div>
                        <label for="promoVideoUrl" class="block text-sm font-medium text-gray-700 mb-1">Promo Video URL</label>
                        <input type="url" name="promoVideoUrl" id="promoVideoUrl"
                               class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                               placeholder="https://example.com/video" value="{{ production.promoVideoUrl }}">
                    </div>

                    <div>
                        <label for="ticketPurchaseUrl" class="block text-sm font-medium text-gray-700 mb-1">Ticket Purchase
                            URL</label>
                        <input type="url" name="ticketPurchaseUrl" id="ticketPurchaseUrl"
                               class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                               placeholder="https://example.com/tickets" value="{{ production.ticketPurchaseUrl }}">
                    </div>

                    <div class="md:col-span-2">
                        <label for="works" class="block text-sm font-medium text-gray-700 mb-1">Works</label>
                        <select multiple="multiple" name="works" id="works" class="w-full rounded-md border-gray-300 shadow-sm">
                            {% for w in works %}
                                <option value="{{ w.id }}">{{ w.title }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <label for="poster" class="block text-sm font-medium text-gray-700 mb-1">Featured Image</label>
                        {% if production.hasFeaturedImage() %}
                            <div class="w-full h-40 overflow-hidden rounded-md border border-gray-200 bg-gray-50">
                                <img src="{{ production.featuredImageUrl }}" alt="Featured image for {{ production.name }}"
                                     class="object-contain w-full h-full">
                            </div>
                        {% endif %}
                        <input type="file" name="poster" id="poster" accept="image/*"
                               class="w-full">
                    </div>

                </div>
            </div>{# /tab-details #}

            {# ── Tab 2: People ──────────────────────────────────────────────── #}
            <div id="tab-people" role="tabpanel" aria-labelledby="tab-people-btn" class="hidden">

                {% if people is empty %}
                    <div class="mb-4 rounded-md bg-yellow-50 p-4 border border-yellow-200">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-yellow-600" xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd"
                                          d="M8.257 3.099c.765-1.36 2.681-1.36 3.446 0l5.516 9.8A1.75 1.75 0 0 1 16.016 16H3.984A1.75 1.75 0 0 1 2.74 12.899l5.517-9.8zM11 13a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-1-8a.75.75 0 0 0-.75.75v4.5a.75.75 0 0 0 1.5 0v-4.5A.75.75 0 0 0 10 5z"
                                          clip-rule="evenodd"/>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-yellow-800">No people available</h3>
                                <div class="mt-1 text-sm text-yellow-700">
                                    There are no people in the system. Add people from the People section before
                                    assigning creatives or performers.
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="space-y-6">
                    {# Creative Team #}
                    <div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base border border-default">
                        <table class="w-full text-sm text-left rtl:text-right text-body">
                            <thead class="text-sm text-body bg-neutral-secondary-medium border-b border-default-medium">
                            <tr>
                                <th scope="col" class="px-6 py-3 font-medium">
                                    Creative Team
                                </th>
                                <th scope="col" class="px-6 py-3 font-medium">
                                    Role
                                </th>
                                <th>
                                    <button type="button" id="add-creative">Add Creative</button>
                                </th>
                            </tr>
                            </thead>
                            <tbody data-creative-rows>
                            {% if creatives is empty %}
                                <tr class="bg-neutral-primary-soft border-b border-default" data-creative-row>
                                    <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                        <select aria-label="Person" class="w-full rounded-md border-gray-300 shadow-sm"
                                                name="creativeIds[]">
                                            <option value="">Select a person</option>
                                            {% for p in people %}
                                                <option value="{{ p.id }}">{{ p.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </th>
                                    <td class="px-6 py-4">
                                        <label class="sr-only" for="creative-role-empty">Role</label>
                                        <input class="w-full rounded-md border-gray-300 shadow-sm" type="text"
                                               id="creative-role-empty" name="creativeRoles[]" placeholder="e.g. Director">
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a href="#" class="delete-creative font-medium text-fg-brand hover:underline">Delete</a>
                                    </td>
                                </tr>
                            {% else %}
                                {% for c in creatives %}
                                    <tr class="bg-neutral-primary-soft border-b border-default" data-creative-row>
                                        <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                            <select aria-label="Person" class="w-full rounded-md border-gray-300 shadow-sm"
                                                    name="creativeIds[]">
                                                <option value="">Select a person</option>
                                                {% for p in people %}
                                                    <option value="{{ p.id }}" {% if p.id == c.person.id %}selected{% endif %}>
                                                        {{ p.name }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </th>
                                        <td class="px-6 py-4">
                                            <label class="sr-only" for="creative-role-{{ loop.index0 }}">Role</label>
                                            <input class="w-full rounded-md border-gray-300 shadow-sm" type="text"
                                                   id="creative-role-{{ loop.index0 }}" name="creativeRoles[]"
                                                   placeholder="e.g. Director" value="{{ c.role }}">
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <a href="#" class="delete-creative font-medium text-fg-brand hover:underline">Delete</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                            <tr class="hidden bg-neutral-primary-soft border-b border-default" data-creative-template>
                                <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                    <select aria-label="Person" class="w-full rounded-md border-gray-300 shadow-sm"
                                            name="creativeIds[]">
                                        <option value="">Select a person</option>
                                        {% for p in people %}
                                            <option value="{{ p.id }}">{{ p.name }}</option>
                                        {% endfor %}
                                    </select>
                                </th>
                                <td class="px-6 py-4">
                                    <label class="sr-only" for="creative-role-template">Role</label>
                                    <input class="w-full rounded-md border-gray-300 shadow-sm" type="text"
                                           id="creative-role-template" name="creativeRoles[]" placeholder="e.g. Director">
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <a href="#" class="delete-creative font-medium text-fg-brand hover:underline">Delete</a>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>

                    {# Performers #}
                    <div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base border border-default">
                        <table class="w-full text-sm text-left rtl:text-right text-body">
                            <thead class="text-sm text-body bg-neutral-secondary-medium border-b border-default-medium">
                            <tr>
                                <th scope="col" class="px-6 py-3 font-medium">
                                    Performers
                                </th>
                                <th scope="col" class="px-6 py-3 font-medium">
                                    Role
                                </th>
                                <th>
                                    <button type="button" id="add-performer">Add Performer</button>
                                </th>
                            </tr>
                            </thead>
                            <tbody data-performer-rows>
                            {% if performers is empty %}
                                <tr class="bg-neutral-primary-soft border-b border-default" data-performer-row>
                                    <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                        <select aria-label="Person" class="w-full rounded-md border-gray-300 shadow-sm"
                                                name="performerIds[]">
                                            <option value="">Select a person</option>
                                            {% for p in people %}
                                                <option value="{{ p.id }}">{{ p.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </th>
                                    <td class="px-6 py-4">
                                        <label class="sr-only" for="performer-role-empty">Role</label>
                                        <input class="w-full rounded-md border-gray-300 shadow-sm" type="text"
                                               id="performer-role-empty" name="performerRoles[]" placeholder="e.g. Hamlet">
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a href="#" class="delete-performer font-medium text-fg-brand hover:underline">Delete</a>
                                    </td>
                                </tr>
                            {% else %}
                                {% for p in performers %}
                                    <tr class="bg-neutral-primary-soft border-b border-default" data-performer-row>
                                        <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                            <select aria-label="Person" class="w-full rounded-md border-gray-300 shadow-sm"
                                                    name="performerIds[]">
                                                <option value="">Select a person</option>
                                                {% for person in people %}
                                                    <option value="{{ person.id }}" {% if person.id == p.person.id %}selected{% endif %}>
                                                        {{ person.name }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </th>
                                        <td class="px-6 py-4">
                                            <label class="sr-only" for="performer-role-{{ loop.index0 }}">Role</label>
                                            <input class="w-full rounded-md border-gray-300 shadow-sm" type="text"
                                                   id="performer-role-{{ loop.index0 }}" name="performerRoles[]"
                                                   placeholder="e.g. Hamlet" value="{{ p.role }}">
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <a href="#" class="delete-performer font-medium text-fg-brand hover:underline">Delete</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                            <tr class="hidden bg-neutral-primary-soft border-b border-default" data-performer-template>
                                <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                    <select aria-label="Person" class="w-full rounded-md border-gray-300 shadow-sm"
                                            name="performerIds[]">
                                        <option value="">Select a person</option>
                                        {% for p in people %}
                                            <option value="{{ p.id }}">{{ p.name }}</option>
                                        {% endfor %}
                                    </select>
                                </th>
                                <td class="px-6 py-4">
                                    <label class="sr-only" for="performer-role-template">Role</label>
                                    <input class="w-full rounded-md border-gray-300 shadow-sm" type="text"
                                           id="performer-role-template" name="performerRoles[]" placeholder="e.g. Hamlet">
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <a href="#" class="delete-performer font-medium text-fg-brand hover:underline">Delete</a>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>{# /tab-people #}

            {# ── Tab 3: Sponsors ────────────────────────────────────────────── #}
            <div id="tab-sponsors" role="tabpanel" aria-labelledby="tab-sponsors-btn" class="hidden">

                <div class="space-y-4 p-6 border border-dashed border-gray-200 rounded-lg bg-gray-50">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900 mb-1">Production Sponsorships</h2>
                            <p class="text-sm text-gray-600">Select sponsors that are attached to this production.</p>
                        </div>
                        <button type="button"
                                id="add-sponsorship"
                                class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 {% if sponsorsList is empty %}opacity-50 cursor-not-allowed{% endif %}"
                                {% if sponsorsList is empty %}disabled{% endif %}>
                            Add Sponsorship
                        </button>
                    </div>

                    {% if sponsorsList is empty %}
                        <div class="rounded-md bg-yellow-50 border border-yellow-200 p-4 text-sm text-yellow-800">
                            There are no sponsors yet. Add sponsors from the Sponsors section before assigning them here.
                        </div>
                    {% else %}
                        <div class="relative overflow-x-auto bg-white border border-gray-200 shadow-sm rounded-md">
                            <table class="w-full text-sm text-left text-gray-700">
                                <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 border-b border-gray-200">
                                <tr>
                                    <th class="px-4 py-3 font-medium">Sponsor</th>
                                    <th class="px-4 py-3 font-medium text-right">Action</th>
                                </tr>
                                </thead>
                                <tbody data-sponsorship-rows>
                                {% if existingSponsorships|length %}
                                    {% for sponsorship in existingSponsorships %}
                                        <tr class="bg-white border-b border-gray-100" data-sponsorship-row>
                                            <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                                <select name="sponsorshipSponsorIds[]" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                                    <option value="">Select a sponsor</option>
                                                    {% for sponsor in sponsorsList %}
                                                        <option value="{{ sponsor.id }}" {% if sponsor.id == sponsorship.sponsor.id %}selected{% endif %}>
                                                            {{ sponsor.name }}
                                                        </option>
                                                    {% endfor %}
                                                </select>
                                            </th>
                                            <td class="px-4 py-3 text-right">
                                                <a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr class="bg-white border-b border-gray-100" data-sponsorship-row>
                                        <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                            <select name="sponsorshipSponsorIds[]" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                                <option value="">Select a sponsor</option>
                                                {% for sponsor in sponsorsList %}
                                                    <option value="{{ sponsor.id }}">{{ sponsor.name }}</option>
                                                {% endfor %}
                                            </select>
                                        </th>
                                        <td class="px-4 py-3 text-right">
                                            <a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
                                        </td>
                                    </tr>
                                {% endif %}
                                <tr class="hidden bg-white border-b border-gray-100" data-sponsorship-template>
                                    <th scope="row" class="px-4 py-3 font-medium text-gray-900">
                                        <select name="sponsorshipSponsorIds[]" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                            <option value="">Select a sponsor</option>
                                            {% for sponsor in sponsorsList %}
                                                <option value="{{ sponsor.id }}">{{ sponsor.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </th>
                                    <td class="px-4 py-3 text-right">
                                        <a href="#" class="delete-sponsorship font-medium text-blue-600 hover:underline">Delete</a>
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>

            </div>{# /tab-sponsors #}

            {# ── Save / Cancel (visible for tabs 1–3, hidden on Performances tab) #}
            <div id="form-actions" class="flex items-center justify-end space-x-3 pt-4 border-t">
                <a href="/{{ base_path|default('') }}admin/productions"
                   class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Save Changes
                </button>
            </div>

        </form>

        {# ── Tab 4: Performances (outside the main form — has its own HTMX forms) #}
        <div id="tab-performances" role="tabpanel" aria-labelledby="tab-performances-btn" class="hidden">
            {% include 'admin/productions/_events.html.twig' with {
                events: events|default([]),
                venues: venues,
                productionId: production.id,
                production: production
            } %}
        </div>{# /tab-performances #}

    </div>{# /prod-tab-content #}

{% endblock %}
    {% block scripts %}
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Hide Save/Cancel when the Performances tab is active
                const formActions = document.getElementById('form-actions');
                document.querySelectorAll('#prod-tabs [data-tabs-target]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        const isPerformances = btn.getAttribute('data-tabs-target') === '#tab-performances';
                        formActions.classList.toggle('hidden', isPerformances);
                    });
                });
                const form = document.querySelector('form');
                const nameInput = document.getElementById('name');
                const seasonInput = document.getElementById('seasonId');

                const setupDynamicRows = (namespace) => {
                    const rowsBody = document.querySelector(`tbody[data-${namespace}-rows]`);
                    const templateRow = rowsBody ? rowsBody.querySelector(`tr[data-${namespace}-template]`) : null;
                    const addButton = document.getElementById(`add-${namespace}`);

                    if (!rowsBody || !templateRow) {
                        return;
                    }

                    const getVisibleRows = () => Array.from(rowsBody.querySelectorAll(`tr[data-${namespace}-row]`));

                    const resetRowInputs = (row) => {
                        const select = row.querySelector('select');
                        if (select) {
                            select.value = '';
                        }
                        const input = row.querySelector('input[type="text"]');
                        if (input) {
                            input.value = '';
                        }
                    };

                    const attachDeleteHandler = (row) => {
                        const deleteLink = row.querySelector(`.delete-${namespace}`);
                        if (!deleteLink) {
                            return;
                        }

                        deleteLink.addEventListener('click', function (event) {
                            event.preventDefault();
                            const visibleRows = getVisibleRows();
                            if (visibleRows.length <= 1) {
                                resetRowInputs(row);
                                return;
                            }

                            row.remove();
                        });
                    };

                    const createRow = () => {
                        const newRow = templateRow.cloneNode(true);
                        newRow.removeAttribute(`data-${namespace}-template`);
                        newRow.setAttribute(`data-${namespace}-row`, '');
                        newRow.classList.remove('hidden');

                        const select = newRow.querySelector('select');
                        if (select) {
                            select.value = '';
                        }

                        const input = newRow.querySelector('input[type="text"]');
                        if (input) {
                            const newId = `${namespace}-role-${getVisibleRows().length}`;
                            input.id = newId;
                            input.value = '';
                            const label = newRow.querySelector('label');
                            if (label) {
                                label.setAttribute('for', newId);
                            }
                        }

                        return newRow;
                    };

                    getVisibleRows().forEach((row) => attachDeleteHandler(row));

                    const ensureRowPresent = () => {
                        if (getVisibleRows().length === 0) {
                            const row = createRow();
                            if (row) {
                                attachDeleteHandler(row);
                                rowsBody.insertBefore(row, templateRow);
                            }
                        }
                    };

                    ensureRowPresent();

                    if (addButton) {
                        addButton.addEventListener('click', function (event) {
                            event.preventDefault();
                            const row = createRow();
                            if (row) {
                                attachDeleteHandler(row);
                                rowsBody.insertBefore(row, templateRow);
                            }
                        });
                    }
                };

                setupDynamicRows('creative');
                setupDynamicRows('performer');
                setupDynamicRows('sponsorship');

                BlockNoteEditor.mountBlockNoteEditor({
                    holderId: 'blocknote-holder',
                    fieldId: 'description',
                    initialData: document.getElementById('description')?.value ?? null,
                    imageUploadEndpoint: '/admin/productions/images/upload',
                });

                form.addEventListener('submit', function(event) {
                    event.preventDefault();

                    if (!nameInput.value.trim()) {
                        alert('Please provide a production name.');
                        nameInput.focus();
                        return;
                    }

                    if (!seasonInput || !seasonInput.value) {
                        alert('Please select or enter a season for the production.');
                        if (seasonInput) seasonInput.focus();
                        return;
                    }

                    form.dispatchEvent(new Event('htmxSubmit'));
                });

                form.addEventListener('htmx:afterRequest', function() {
                    document.getElementById('flash-messages')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                });
            });
        </script>
{% endblock %}
