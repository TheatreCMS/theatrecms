{% extends 'layouts/admin.html.twig' %}

{% block title %}My Profile - {{ parent() }}{% endblock %}

{% block content %}
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">My Profile</h1>
            <p class="text-gray-600">Update your account details.</p>
        </div>
    </div>

    <form action="/admin/profile" method="post" class="bg-white shadow-sm rounded p-6 space-y-6" novalidate
          hx-post="/admin/profile" hx-target="#flash-messages" hx-swap="innerHTML">
        {% if csrf_token is defined %}
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        {% endif %}

        {% if errors.general is defined %}
            <div class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
                {{ errors.general }}
            </div>
        {% endif %}

        <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email address <span class="text-red-500">*</span></label>
            <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    aria-describedby="email-error"
                    {% if errors.email is defined %}aria-invalid="true"{% endif %}
                    value="{{ old.email|default(user.email) }}"
                    class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 {% if errors.email is defined %}border-red-500{% endif %}"
            >
            {% if errors.email is defined %}
                <p id="email-error" class="text-red-600 text-sm mt-1">{{ errors.email }}</p>
            {% else %}
                <p id="email-error" class="sr-only" aria-hidden="true"></p>
            {% endif %}
        </div>

        <div>
            <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
            <input
                    id="username"
                    type="text"
                    value="{{ user.username }}"
                    class="w-full border rounded px-3 py-2 bg-gray-50 text-gray-500 cursor-not-allowed"
                    readonly
                    disabled
            >
            <p class="text-xs text-gray-500 mt-1">Usernames are display-only and cannot be changed from the admin UI.</p>
        </div>

        <div class="border-t pt-6">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Change Password</h2>
            <div class="space-y-4">
                <div>
                    <label for="current_password" class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
                    <input
                            id="current_password"
                            name="current_password"
                            type="password"
                            aria-describedby="current-password-error"
                            {% if errors.current_password is defined %}aria-invalid="true"{% endif %}
                            class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 {% if errors.current_password is defined %}border-red-500{% endif %}"
                    >
                    {% if errors.current_password is defined %}
                        <p id="current-password-error" class="text-red-600 text-sm mt-1">{{ errors.current_password }}</p>
                    {% else %}
                        <p id="current-password-error" class="sr-only" aria-hidden="true"></p>
                    {% endif %}
                    <p class="text-xs text-gray-500 mt-1">Only required if you're setting a new password below.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
                        <input
                                id="password"
                                name="password"
                                type="password"
                                aria-describedby="password-error"
                                {% if errors.password is defined %}aria-invalid="true"{% endif %}
                                class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 {% if errors.password is defined %}border-red-500{% endif %}"
                        >
                        {% if errors.password is defined %}
                            <p id="password-error" class="text-red-600 text-sm mt-1">{{ errors.password }}</p>
                        {% else %}
                            <p id="password-error" class="sr-only" aria-hidden="true"></p>
                        {% endif %}
                        <p class="text-xs text-gray-500 mt-1">Leave blank to keep your current password.</p>
                    </div>

                    <div>
                        <label for="password_confirmation" class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password</label>
                        <input
                                id="password_confirmation"
                                name="password_confirmation"
                                type="password"
                                aria-describedby="password-confirmation-error password-match-error"
                                {% if errors.password_confirmation is defined %}aria-invalid="true"{% endif %}
                                class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 {% if errors.password_confirmation is defined %}border-red-500{% endif %}"
                        >
                        {% if errors.password_confirmation is defined %}
                            <p id="password-confirmation-error" class="text-red-600 text-sm mt-1">{{ errors.password_confirmation }}</p>
                        {% else %}
                            <p id="password-confirmation-error" class="sr-only" aria-hidden="true"></p>
                        {% endif %}
                        <p id="password-match-error" class="text-red-600 text-sm mt-1 hidden" aria-live="polite" role="alert" aria-hidden="true">Passwords do not match.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3">
            <button id="save-profile-submit" type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Save Changes</button>
        </div>
    </form>

    {% block scripts %}
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.querySelector('form');
                const pwd = document.getElementById('password');
                const confirm = document.getElementById('password_confirmation');
                const matchError = document.getElementById('password-match-error');
                const submitBtn = document.getElementById('save-profile-submit');

                function setAriaInvalid(el, flag) {
                    if (!el) return;
                    if (flag) el.setAttribute('aria-invalid', 'true');
                    else el.removeAttribute('aria-invalid');
                }

                function clearErrorStyles() {
                    if (pwd) pwd.classList.remove('border-red-500');
                    if (confirm) confirm.classList.remove('border-red-500');
                    setAriaInvalid(pwd, false);
                    setAriaInvalid(confirm, false);
                    if (matchError) {
                        matchError.classList.add('hidden');
                        matchError.setAttribute('aria-hidden', 'true');
                    }
                }

                function showErrorStyles() {
                    if (pwd) pwd.classList.add('border-red-500');
                    if (confirm) confirm.classList.add('border-red-500');
                    setAriaInvalid(pwd, true);
                    setAriaInvalid(confirm, true);
                    if (matchError) {
                        matchError.classList.remove('hidden');
                        matchError.setAttribute('aria-hidden', 'false');
                    }
                }

                function checkMatch() {
                    if (!pwd || !confirm || !matchError) return true;
                    if (!pwd.value && !confirm.value) {
                        clearErrorStyles();
                        return true;
                    }
                    if (pwd.value && !confirm.value) {
                        showErrorStyles();
                        return false;
                    }
                    if (!pwd.value && confirm.value) {
                        showErrorStyles();
                        return false;
                    }
                    if (pwd.value === confirm.value) {
                        clearErrorStyles();
                        return true;
                    }
                    showErrorStyles();
                    return false;
                }

                if (pwd && confirm) {
                    pwd.addEventListener('input', function () {
                        checkMatch();
                    });
                    confirm.addEventListener('input', function () {
                        checkMatch();
                    });
                }

                if (form) {
                    form.addEventListener('submit', function (e) {
                        if (!checkMatch()) {
                            e.preventDefault();
                            confirm.focus();
                        }
                    });
                }

                checkMatch();
            });
        </script>
    {% endblock %}
{% endblock %}
