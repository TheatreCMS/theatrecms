{% extends 'layouts/admin.html.twig' %}

{% block title %}Users - {{ parent() }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">Users</h1>
        <p class="text-gray-600">Manage website users.</p>
    </div>
    <div>
        <a href="/admin/users/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Add New User</a>
    </div>
</div>

<table class="w-full text-sm text-left rtl:text-right text-body">
    <thead class="text-sm text-body bg-neutral-secondary-soft border-b rounded-base border-default">
        <tr>
            <th scope="col" class="px-6 py-3 font-medium">
                Email address
            </th>
            <th scope="col" class="px-6 py-3 font-medium">
                Last login
            </th>
            <th scope="col" class="px-6 py-3 font-medium">
                Actions
            </th>
        </tr>
    </thead>
    <tbody id="userList">
    {% for u in users %}
        <tr class="bg-neutral-primary border-b border-default">
            <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                {{ u.email }}
            </th>
            <td class="px-6 py-4">
                {{ u.lastLogin ? u.lastLogin|date('m/d/Y H:i:s') : 'Never' }}
            </td>
            <td class="px-6 py-4">
                <a href="/admin/users/edit/{{ u.id }}" class="text-blue-600 hover:text-blue-900 mr-4">Edit</a>
                {% if currentUserId != u.id %}
                <button type="button" class="text-red-600 hover:text-red-900" hx-delete="/admin/users/{{ u.id }}" hx-target="#userList">Delete</button>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr class="bg-neutral-primary border-b border-default">
            <td class="px-6 py-4">No users found.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
