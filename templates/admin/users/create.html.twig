{# templates/admin/users/create.html.twig #}
{% extends 'layouts/admin.html.twig' %}

{% block title %}Create User - {{ parent() }}{% endblock %}

{% block content %}
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">Create User</h1>
            <p class="text-gray-600">Add a new website user.</p>
        </div>
        <div>
            <a href="/admin/users" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded">Back to Users</a>
        </div>
    </div>

    <form action="/admin/users/create" method="post" class="bg-white shadow-sm rounded p-6 space-y-6" novalidate
          hx-post="/admin/users/create" hx-target="#flash-messages" hx-swap="innerHTML">
        {% if csrf_token is defined %}
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        {% endif %}

        {% if errors.general is defined %}
            <div class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
                {{ errors.general }}
            </div>
        {% endif %}

        <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email address <span class="text-red-500">*</span></label>
            <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    aria-describedby="email-error"
                    {% if errors.email is defined %}aria-invalid="true"{% endif %}
                    value="{{ old.email|default('') }}"
                    class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 {% if errors.email is defined %}border-red-500{% endif %}"
            >
            {% if errors.email is defined %}
                <p id="email-error" class="text-red-600 text-sm mt-1">{{ errors.email }}</p>
            {% else %}
                <p id="email-error" class="sr-only" aria-hidden="true"></p>
            {% endif %}
        </div>

        <div>
            <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username <span class="text-red-500">*</span></label>
            <input
                    id="username"
                    name="username"
                    type="text"
                    required
                    aria-describedby="username-error"
                    {% if errors.username is defined %}aria-invalid="true"{% endif %}
                    value="{{ old.username|default('') }}"
                    class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 {% if errors.username is defined %}border-red-500{% endif %}"
            >
            {% if errors.username is defined %}
                <p id="username-error" class="text-red-600 text-sm mt-1">{{ errors.username }}</p>
            {% else %}
                <p id="username-error" class="sr-only" aria-hidden="true"></p>
            {% endif %}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password <span class="text-red-500">*</span></label>
                <input
                        id="password"
                        name="password"
                        type="password"
                        required
                        aria-describedby="password-error"
                        {% if errors.password is defined %}aria-invalid="true"{% endif %}
                        class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 {% if errors.password is defined %}border-red-500{% endif %}"
                >
                {% if errors.password is defined %}
                    <p id="password-error" class="text-red-600 text-sm mt-1">{{ errors.password }}</p>
                {% else %}
                    <p id="password-error" class="sr-only" aria-hidden="true"></p>
                {% endif %}
            </div>

            <div>
                <label for="password_confirmation" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password <span class="text-red-500">*</span></label>
                <input
                        id="password_confirmation"
                        name="password_confirmation"
                        type="password"
                        required
                        aria-describedby="password-confirmation-error password-match-error"
                        {% if errors.password_confirmation is defined %}aria-invalid="true"{% endif %}
                        class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 {% if errors.password_confirmation is defined %}border-red-500{% endif %}"
                >
                {% if errors.password_confirmation is defined %}
                    <p id="password-confirmation-error" class="text-red-600 text-sm mt-1">{{ errors.password_confirmation }}</p>
                {% else %}
                    <p id="password-confirmation-error" class="sr-only" aria-hidden="true"></p>
                {% endif %}
                <p id="password-match-error" class="text-red-600 text-sm mt-1 hidden" aria-live="polite" role="alert" aria-hidden="true">Passwords do not match.</p>
            </div>
        </div>

        <div>
            <label for="role" class="block text-sm font-medium text-gray-700 mb-1">Role</label>
            <select id="role" name="role" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="user" {% if old.role|default('user') == 'user' %}selected{% endif %}>User</option>
                <option value="admin" {% if old.role is defined and old.role == 'admin' %}selected{% endif %}>Admin</option>
            </select>
            {% if errors.role is defined %}
                <p id="role-error" class="text-red-600 text-sm mt-1">{{ errors.role }}</p>
            {% else %}
                <p id="role-error" class="sr-only" aria-hidden="true"></p>
            {% endif %}
        </div>

        <div class="flex items-center justify-end space-x-3">
            <a href="/admin/users" class="inline-block bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-2 px-4 rounded">Cancel</a>
            <button id="create-user-submit" type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" disabled aria-disabled="true">
                Create User
            </button>
        </div>
    </form>

    {% block scripts %}
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.querySelector('form');
                const pwd = document.getElementById('password');
                const confirm = document.getElementById('password_confirmation');
                const matchError = document.getElementById('password-match-error');
                const submitBtn = document.getElementById('create-user-submit');

                function setAriaInvalid(el, flag) {
                    if (!el) return;
                    if (flag) el.setAttribute('aria-invalid', 'true');
                    else el.removeAttribute('aria-invalid');
                }

                function clearErrorStyles() {
                    if (pwd) pwd.classList.remove('border-red-500');
                    if (confirm) confirm.classList.remove('border-red-500');
                    setAriaInvalid(pwd, false);
                    setAriaInvalid(confirm, false);
                    if (matchError) {
                        matchError.classList.add('hidden');
                        matchError.setAttribute('aria-hidden', 'true');
                    }
                }

                function showErrorStyles() {
                    if (pwd) pwd.classList.add('border-red-500');
                    if (confirm) confirm.classList.add('border-red-500');
                    setAriaInvalid(pwd, true);
                    setAriaInvalid(confirm, true);
                    if (matchError) {
                        matchError.classList.remove('hidden');
                        matchError.setAttribute('aria-hidden', 'false');
                    }
                }

                function updateSubmitState(valid) {
                    if (!submitBtn) return;
                    if (valid) {
                        submitBtn.disabled = false;
                        submitBtn.removeAttribute('aria-disabled');
                    } else {
                        submitBtn.disabled = true;
                        submitBtn.setAttribute('aria-disabled', 'true');
                    }
                }

                function checkMatch() {
                    if (!pwd || !confirm || !matchError) return true;
                    // If both empty, don't show mismatch but keep submit disabled
                    if (!pwd.value && !confirm.value) {
                        clearErrorStyles();
                        updateSubmitState(false);
                        return false;
                    }
                    if (pwd.value === confirm.value) {
                        clearErrorStyles();
                        updateSubmitState(true);
                        return true;
                    }
                    showErrorStyles();
                    updateSubmitState(false);
                    return false;
                }

                // Wire up listeners
                if (pwd && confirm) {
                    pwd.addEventListener('input', checkMatch);
                    confirm.addEventListener('input', checkMatch);
                }

                if (form) {
                    form.addEventListener('submit', function (e) {
                        if (!checkMatch()) {
                            e.preventDefault();
                            confirm.focus();
                        }
                    });
                }

                // Initial check (this will enable the button when the page is rendered with matching values or server-side errors are present)
                checkMatch();
            });
        </script>
    {% endblock %}
{% endblock %}
