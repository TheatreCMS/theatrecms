{% for page in pages %}
    <tr class="bg-neutral-primary border-b border-default">
        <td class="px-6 py-4">
            <div class="text-sm font-medium text-gray-900">{{ page.title }}</div>
            <div class="text-xs text-gray-500">Slug: {{ page.slug }}</div>
        </td>
        <td class="px-6 py-4">
            {{ page.modifiedAt|date('Y-m-d H:i') }}
        </td>
        <td class="px-6 py-4 text-right space-x-2">
            <a href="/admin/pages/edit/{{ page.id }}" class="text-blue-600 hover:text-blue-900">Edit</a>
            <button type="button" class="text-red-600 hover:text-red-900" hx-delete="/admin/pages/{{ page.id }}?page={{ pagination.page }}" hx-target="#pageListContainer" hx-swap="outerHTML">Delete</button>
        </td>
    </tr>
{% else %}
    <tr class="bg-neutral-primary border-b border-default">
        <td class="px-6 py-4" colspan="3">No pages found.</td>
    </tr>
{% endfor %}
