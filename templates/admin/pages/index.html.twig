{% extends 'layouts/admin.html.twig' %}

{% block title %}Pages - {{ parent() }}{% endblock %}

{% block content %}
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">Pages</h1>
            <p class="text-gray-600">Create and manage static pages such as About, Contact, and FAQ.</p>
        </div>
        <div>
            <a href="/admin/pages/create" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded hover:bg-blue-700">Add New Page</a>
        </div>
    </div>

    <div class="overflow-x-auto bg-white shadow-sm rounded">
        <table class="w-full text-sm text-left text-body">
            <thead class="text-sm text-body bg-neutral-secondary-soft border-b border-default">
                <tr>
                    <th scope="col" class="px-6 py-3 font-medium">Title</th>
                    <th scope="col" class="px-6 py-3 font-medium">Last Updated</th>
                    <th scope="col" class="px-6 py-3 font-medium text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="pageList">
                {% include 'admin/pages/_table.html.twig' with {'pages': pages} %}
            </tbody>
        </table>
    </div>
{% endblock %}
