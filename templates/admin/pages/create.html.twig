{% extends 'layouts/admin.html.twig' %}

{% block title %}Create Page -
	{{ parent() }}
{% endblock %}

{% block content %}
	<div class="mb-6">
		<h1 class="text-2xl font-bold text-gray-800">Create New Page</h1>
		<p class="text-gray-600">Build evergreen content such as About, Contact, and FAQ pages.</p>
	</div>

	<form action="/admin/pages/create" method="POST" class="space-y-6">
		<div class="grid grid-cols-1 gap-6">
			<div>
				<label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
				<input type="text" name="title" id="title" required maxlength="255" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200">
			</div>

			<div class="md:col-span-2 space-y-3">
				<label for="content" class="block text-sm font-medium text-gray-700">Content</label>
				<div id="editorjs" class="rounded-md border border-gray-200 bg-white shadow-sm"></div>
				<textarea name="content" id="content" rows="10" class="hidden" aria-hidden="true"></textarea>
			</div>
		</div>

		<div class="flex items-center justify-end space-x-3 pt-4 border-t">
			<a href="/admin/pages" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancel</a>
			<button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">Create Page</button>
		</div>
	</form>
{% endblock %}

{% block scripts %}
	{{ parent() }}
	<script type="module">
		document.addEventListener('DOMContentLoaded', function () {
const form = document.querySelector('form[action="/admin/pages/create"]');
const contentField = document.getElementById('content');

if (! form || ! contentField) {
return;
}

let isSaving = false;

const handleSubmit = function (event) {
if (isSaving) {
return;
}

event.preventDefault();
isSaving = true;

editor.save().then((outputData) => {
contentField.value = JSON.stringify(outputData);
form.removeEventListener('submit', handleSubmit);
form.submit();
}).catch((error) => {
console.error('EditorJS save failed:', error);
alert('Unable to save the content. Please try again.');
isSaving = false;
});
};

form.addEventListener('submit', handleSubmit);

const editor = new EditorJS({
holder: 'editorjs',
tools: {
paragraph: {
inlineToolbar: [
'bold', 'italic', 'underline', 'link'
],
config: {
preserveBlank: true
}
},
quote: {
class: Quote,
inlineToolbar: true
},
underline: {
class: Underline
},
header: {
class: Header,
inlineToolbar: true
},
list: {
class: EditorjsList,
inlineToolbar: true
},
image: {
class: ImageTool,
config: {
endpoints : {
byFile: '/admin/pages/images/upload',
byUrl: '/admin/pages/images/fetch'
}
}
}
}
});
});
	</script>
{% endblock %}
