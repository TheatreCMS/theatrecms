{% extends 'layouts/admin.html.twig' %}

{% block title %}Create Page -
	{{ parent() }}
{% endblock %}

{% block content %}
	{% include 'admin/partials/_edit_header.html.twig' with {
		formId: 'page-form',
		title: 'Create New Page',
		backUrl: '/admin/pages',
		backLabel: 'Pages',
		subtitle: 'Build evergreen content such as About, Contact, and FAQ pages.',
		submitLabel: 'Create Page',
		create: true
	} %}

	<form id="page-form" action="/admin/pages/create" method="POST" class="space-y-6"
		hx-post="/admin/pages/create"
		hx-target="#flash-messages"
		hx-swap="innerHTML"
		hx-trigger="htmxSubmit">
		<div class="grid grid-cols-1 gap-6">
			<div>
				<label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
				<input type="text" name="title" id="title" required maxlength="255" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200">
			</div>

			<div>
				<label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
				<select name="status" id="status" class="w-full rounded-md border-gray-300 shadow-sm">
					{% for key, label in statuses %}
						<option value="{{ key }}">{{ label }}</option>
					{% endfor %}
				</select>
			</div>

			<div>
				<label for="parentId" class="block text-sm font-medium text-gray-700 mb-1">Parent page</label>
				<select name="parentId" id="parentId" class="w-full rounded-md border-gray-300 shadow-sm">
					<option value="">(none: top level)</option>
					{% for parent in parents %}
						<option value="{{ parent.id }}">{{ parent.title }}</option>
					{% endfor %}
				</select>
			</div>

			{% if supportsHeroImage|default(true) %}
				{% include 'admin/partials/_featured_image_field.html.twig' with {
					entityType: 'page', entityId: null, field: 'hero', label: 'Hero Image',
					featuredImageUrl: null, featuredImageId: null
				} %}
				{% include 'admin/partials/_hero_text_field.html.twig' with { heroText: null } %}
			{% endif %}

			<div class="md:col-span-2 space-y-3">
				<label for="content" class="block text-sm font-medium text-gray-700">Content</label>
				<div id="editorjs" class="rounded-md border border-gray-200 bg-white shadow-sm"></div>
				<textarea name="content" id="content" rows="10" class="hidden" aria-hidden="true"></textarea>
			</div>
		</div>

	</form>
{% endblock %}

{% block scripts %}
	{{ parent() }}
	<script type="module">
		import { buildEditorJsConfig } from '/assets/js/editorjs-config.js';

		document.addEventListener('DOMContentLoaded', function () {
			const form = document.querySelector('form[action="/admin/pages/create"]');
			const contentField = document.getElementById('content');

			if (!form || !contentField) {
				return;
			}

			let isSaving = false;

			const showEditorSaveError = () => {
				document.getElementById('flash-messages').innerHTML =
					'<div id="page-form-alert" role="alert" class="flex items-center gap-3 p-4 mb-4 rounded-lg border bg-red-50 border-red-200 text-red-800">' +
					'<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' +
					'<p class="text-sm font-medium">Unable to save content. Please try again.</p></div>';
			};

			const editor = new EditorJS(buildEditorJsConfig({
				holder: 'editorjs',
				imageEndpoints: {
					byFile: '/admin/pages/images/upload',
					byUrl: '/admin/pages/images/fetch'
				}
			}));

			form.addEventListener('submit', function (event) {
				event.preventDefault();
				if (isSaving) {
					return;
				}
				isSaving = true;

				editor.save().then((outputData) => {
					contentField.value = JSON.stringify(outputData);
					form.dispatchEvent(new Event('htmxSubmit'));
				}).catch((error) => {
					console.error('EditorJS save failed:', error);
					showEditorSaveError();
					form.dispatchEvent(new Event('edit-form:error'));
					isSaving = false;
				});
			});

			form.addEventListener('htmx:afterRequest', (event) => {
				if (event.detail.elt === form) {
					isSaving = false;
				}
			});
		});
	</script>
	{% if supportsHeroImage|default(true) %}
		<script type="module">
			import { initFeaturedImagePicker } from '/assets/js/featured-image-picker.js';
			initFeaturedImagePicker();
		</script>
		{% include 'admin/partials/_image_picker_modal.html.twig' %}
	{% endif %}
{% endblock %}
