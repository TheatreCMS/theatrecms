{% extends 'layouts/admin.html.twig' %}

{% block title %}Edit Page -
	{{ parent() }}
{% endblock %}

{% block content %}
	<div class="mb-6">
		<h1 class="text-2xl font-bold text-gray-800">Edit Page</h1>
		<p class="text-gray-600">Update title, slug, and content for this page.</p>
	</div>

	<form action="/admin/pages/edit" method="POST" class="space-y-6"
		hx-post="/admin/pages/edit"
		hx-target="#flash-messages"
		hx-swap="innerHTML"
		hx-trigger="htmxSubmit">
		<input type="hidden" name="pageId" value="{{ page.id }}">

		<div class="grid grid-cols-1 gap-6">
			<div>
				<label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
				<input type="text" name="title" id="title" required maxlength="255" value="{{ page.title }}" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200">
			</div>

			<div>
				<label for="slug" class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
				<input type="text" name="slug" id="slug" maxlength="255" value="{{ page.slug }}" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200">
			</div>

			<div class="md:col-span-2 space-y-3">
				<label for="content" class="block text-sm font-medium text-gray-700">Content</label>
				<div id="blocknote-holder" class="rounded-md border border-gray-200 bg-white shadow-sm min-h-[200px]"></div>
				<textarea name="content" id="content" rows="10" class="hidden" aria-hidden="true">{{ page.content|default('') }}</textarea>
			</div>
		</div>

		<div class="flex items-center justify-end space-x-3 pt-4 border-t">
			<a href="/admin/pages" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancel</a>
			<button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">Save Changes</button>
		</div>
	</form>
{% endblock %}

{% block scripts %}
	{{ parent() }}
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const form = document.querySelector('form[action="/admin/pages/edit"]');

			if (!form) return;

			BlockNoteEditor.mountBlockNoteEditor({
				holderId: 'blocknote-holder',
				fieldId: 'content',
				initialData: document.getElementById('content')?.value ?? null,
				imageUploadEndpoint: '/admin/pages/images/upload',
			});

			form.addEventListener('submit', function (event) {
				event.preventDefault();
				form.dispatchEvent(new Event('htmxSubmit'));
			});

			form.addEventListener('htmx:afterRequest', () => {
				document.getElementById('flash-messages')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			});
		});
	</script>
{% endblock %}
