{% extends 'layouts/admin.html.twig' %}

{% block title %}Media Library - {{ parent() }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold">Media Library</h1>
        <p class="text-gray-600">Every image uploaded for use as a featured image across the site.</p>
    </div>
</div>

<div class="mb-4">
    <input
        type="search"
        placeholder="Search images by filename…"
        value="{{ pagination.search|default('') }}"
        hx-get="/admin/images"
        hx-trigger="keyup changed delay:300ms"
        hx-target="#images-grid"
        hx-swap="outerHTML"
        name="q"
        class="w-full max-w-sm rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
    >
</div>

<div class="bg-white border border-gray-200 rounded-md shadow-sm">
    {% include 'admin/images/_grid.html.twig' with {'images': images, 'pagination': pagination} %}
</div>
{% endblock %}
