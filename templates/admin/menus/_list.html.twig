<div id="menuListContainer" class="overflow-x-auto bg-white shadow-sm rounded">
    <table class="w-full text-sm text-left text-body">
        <thead class="text-sm text-body bg-neutral-secondary-soft border-b border-default">
            <tr>
                <th scope="col" class="px-6 py-3 font-medium">Name</th>
                <th scope="col" class="px-6 py-3 font-medium">Location</th>
                <th scope="col" class="px-6 py-3 font-medium">Items</th>
                <th scope="col" class="px-6 py-3 font-medium text-right">Actions</th>
            </tr>
        </thead>
        <tbody id="menuList">
            {% include 'admin/menus/_table.html.twig' with {'menus': menus, 'locations': locations} %}
        </tbody>
    </table>
</div>
