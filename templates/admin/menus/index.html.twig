{% extends 'layouts/admin.html.twig' %}

{% block title %}Menus - {{ parent() }}{% endblock %}

{% block content %}
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">Menus</h1>
            <p class="text-gray-600">Build navigation menus and assign them to locations defined by your theme.</p>
        </div>
        <div>
            <a href="/admin/menus/create" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded hover:bg-blue-700">Add New Menu</a>
        </div>
    </div>

    {% include 'admin/menus/_list.html.twig' with {'menus': menus, 'locations': locations} %}
{% endblock %}
