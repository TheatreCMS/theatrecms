# Composer dependencies
/vendor/

# DDEV local development
/.ddev/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.phpunit.result.cache
/build/

# Runtime caches, locks and logs (Twig, Doctrine, scheduler)
/var/

/sql/

# Database dumps (e.g. WordPress exports) hold secrets and personal data: never commit one.
# Keep them outside the repository; these catch stray copies. migrations/*.sql stays tracked.
/*.sql
*.sql.gz
*.sql.bz2
*.sql.xz
/dumps/
/www/themes/*
!/www/themes/default

# Plugins: one folder per plugin, each cloned or copied in locally (see documentation/plugins.md)
/plugins/*
!/plugins/.gitkeep

# Local Composer install that merges core + plugins, with its own lock file
/composer.local.json
/composer.local.lock
/www/uploads/*
node_modules/

# Jetbrains IDE files
/.idea/

# Application configuration files
config.json
app/config.yaml
opencode.json

# Local editor settings
.vscode/settings.json

# PHP CS Fixer configuration
/.php-cs-fixer.cache
/.php-cs-fixer.php

# Twig CS Fixer cache
/.twig-cs-fixer.cache
