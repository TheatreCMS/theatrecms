site:
    organization_name: "Your Org"
    name: "Your Theatre"
    site_url: 'https://your-domain.example'
    logo_url: /assets/images/logo.svg
    contact_email: 'admin@your-domain.example'
    social:
        facebook: ''
        twitter: ''
        instagram: ''

# The active theme, matching a subdirectory name under www/themes.
theme: default

# Override the URL prefix and/or display label used for a built-in content type's
# frontend routes and page titles. Keys are content-type identifiers (seasons,
# productions, people, works, posts). The shorthand form below sets the URL prefix
# and derives the label from it (capitalized); use the expanded form to set an
# independent label. For example, a theatre whose site calls its season listing
# "Shows" can serve it under /shows, with "Shows" used in menu links and page
# <title>s, instead of /seasons and "Seasons":
# content_types:
#     seasons: shows
#     # Equivalent to the above, but lets the label differ from the URL prefix:
#     # seasons:
#     #     url_prefix: shows
#     #     label: Shows
#
# Every content type's archive (listing) page is served by default. Set
# has_archive: false to disable one — its listing route 404s, while
# single-entity routes (e.g. /seasons/{slug}) keep working:
# content_types:
#     seasons:
#         has_archive: false

# Settings for installed plugins, keyed by package name. Each plugin documents its
# own keys; anything secret (API credentials, passwords) belongs here, never in a
# plugin's repository. For example, the WordPress importer's source database:
# plugins:
#     theatrecms/wp-import:
#         source:
#             dbname: wp_source      # defaults: the `database` settings below, with
#             table_prefix: wp_      # dbname wp_source and table prefix wp_

database:
    driver: pdo_mysql
    host: db
    port: 3306
    dbname: db
    user: db
    password: db
    charset: utf8mb4
