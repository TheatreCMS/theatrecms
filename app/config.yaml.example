site:
    organization_name: "Your Org"
    name: "Your Theatre"
    site_url: 'https://your-domain.example'
    logo_url: /assets/images/logo.svg
    contact_email: 'admin@your-domain.example'
    social:
        facebook: ''
        twitter: ''
        instagram: ''

# The active theme, matching a subdirectory name under www/themes.
theme: default

# Override settings of a content type, keyed by its singular name: a built-in one
# (season, production, person, work, post) or one a plugin or theme registers. Each
# override is a map that may set urlPrefix, label, singularLabel, hasArchive,
# public, supports and capability; any other key is an error. A urlPrefix override
# doesn't change the label, so set both when they should match. For example, a
# theatre whose site calls its season listing "Shows" can serve it under /shows,
# with "Shows" used in menu links and page <title>s, instead of /seasons and
# "Seasons":
# content_types:
#     season:
#         urlPrefix: shows
#         label: Shows
#
# Every content type's archive (listing) page is served by default. Set
# hasArchive: false to disable one — its listing route 404s, while
# single-entity routes (e.g. /seasons/{slug}) keep working:
# content_types:
#     season:
#         hasArchive: false

# Settings for installed plugins, keyed by package name. Each plugin documents its
# own keys; anything secret (API credentials, passwords) belongs here, never in a
# plugin's repository. For example, the WordPress importer's source database:
# plugins:
#     theatrecms/wp-import:
#         source:
#             dbname: wp_source      # defaults: the `database` settings below, with
#             table_prefix: wp_      # dbname wp_source and table prefix wp_

database:
    driver: pdo_mysql
    host: db
    port: 3306
    dbname: db
    user: db
    password: db
    charset: utf8mb4
