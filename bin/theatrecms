use TheatreCMS\Console\ConsoleApplicationFactory;

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "bin/theatrecms must be run from the command line.\n");
    exit(1);
}

/** @var \DI\Container $container */
$container = require dirname(__DIR__) . '/app/bootstrap.php';

$container->get(ConsoleApplicationFactory::class)->create()->run();
