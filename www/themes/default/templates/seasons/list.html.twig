{% extends 'layouts/base.html.twig' %}

{% block title %}Seasons - {{ parent() }}{% endblock %}

{% block content %}
    <h1>Our Seasons</h1>
    <ul>
        {% for season in seasons %}
            <li>
                <a href="{{ the_permalink(season) }}">
                    {% if season.featuredImageUrl %}
                        <img src="{{ season.featuredImageUrl }}" alt="{{ season.label }}" class="season-featured-image-thumb">
                    {% endif %}
                    {{ season.label }}
                </a>
            </li>
        {% else %}
            <li>No seasons found.</li>
        {% endfor %}
    </ul>
{% endblock %}