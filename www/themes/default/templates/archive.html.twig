{% extends 'layouts/base.html.twig' %}

{% block title %}{{ seo.title }}{% endblock %}

{# Fallback for any content type without its own {prefix}/archive.html.twig; uses only the generic context. #}
{% block content %}
    <header class="space-y-2">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">{{ page.title }}</h1>
    </header>

    <ul class="space-y-6">
        {% for item in posts %}
            <li class="space-y-1">
                <a href="{{ the_permalink(item) }}" class="text-xl font-semibold text-gray-900 hover:underline">
                    {{ the_title(item) }}
                </a>
                {% if item.publishedAt is defined and item.publishedAt %}
                    <p class="text-sm text-gray-500">
                        <time datetime="{{ item.publishedAt|date('Y-m-d') }}">{{ item.publishedAt|date('F j, Y') }}</time>
                    </p>
                {% endif %}
                {% if item.excerpt is defined and item.excerpt %}
                    <p class="text-gray-700 leading-relaxed">{{ the_excerpt(item) }}</p>
                {% endif %}
            </li>
        {% else %}
            <li class="text-gray-600">Nothing here yet.</li>
        {% endfor %}
    </ul>
{% endblock %}
