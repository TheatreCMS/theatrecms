{# Reusable post partial - expects a `post` variable #}
<article class="bg-white shadow rounded-lg overflow-hidden {% if post.featuredImageUrl %}md:flex{% endif %}">
    {% if post.featuredImageUrl %}
        <img
            src="{{ post.featuredImageUrl }}"
            alt="{{ post.title }}"
            class="w-full h-64 object-cover md:w-80 md:h-auto md:flex-shrink-0"
        >
    {% endif %}

    <div class="p-8 space-y-6 flex-1">
        <header>
            <h2 class="text-2xl font-bold text-gray-900">{{ post.title }}</h2>
        </header>
        <p class="text-sm text-gray-500">
            {{ post.publishedAt ? post.publishedAt|date('F j, Y') : 'Unpublished' }}
        </p>

        <div class="prose max-w-none text-gray-800">
            {{ the_content(post) }}
        </div>
    </div>
</article>

