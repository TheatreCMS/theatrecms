{% extends 'layouts/base.html.twig' %}

{% block title %}{{ person.name }} - {{ parent() }}{% endblock %}

{% block content %}
    <article class="max-w-3xl mx-auto bg-white shadow-sm rounded-lg p-6 sm:p-8 space-y-6">
        <header class="space-y-4 text-center">
            {% if person.headshotUrl %}
                <img
                    src="{{ person.headshotUrl }}"
                    alt="{{ person.name }}"
                    class="w-36 h-36 mx-auto rounded-full object-cover border border-gray-200"
                >
            {% else %}
                <div class="w-36 h-36 mx-auto rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center text-4xl font-light text-gray-400">
                    {{ person.firstName|slice(0, 1) }}{{ person.lastName|slice(0, 1) }}
                </div>
            {% endif %}

            <h1 class="text-3xl sm:text-4xl font-semibold text-gray-900">{{ person.name }}</h1>
        </header>

        <section class="prose prose-gray max-w-none">
            {% if person.biography %}
                {{ person.biography|raw }}
            {% else %}
                <p class="italic text-gray-500">Biography coming soon.</p>
            {% endif %}
        </section>
    </article>
{% endblock %}
